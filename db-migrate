    echo "| Acceptable replication lag | $MAX_LAG_SECONDS s |"
    echo "| Deadline | ${DEADLINE:-not set} |"
    echo
    echo "These are evaluated against the measurements in \`plan.md\`."
    echo
    echo "## Blockers"
    echo; bullets "$STATE/blockers.txt"; echo
    echo "## Warnings"
    echo; bullets "$STATE/warnings.txt"; echo
    echo "## Notes"
    echo; bullets "$STATE/notes.txt"
  } > "$f"
}

# ── 2. plan ─────────────────────────────────────────────────────────────────

measured_throughput() { # bytes/sec from the latest successful timed load, or empty
  [ -f "$STATE/runs.log" ] || return 0
  awk -F'|' '($3 == "full-load" || $3 == "initial-sync") && $6 == "ok" && $4 > 0 && $5 > 0 { r = int($5 / $4); p = $2 } END { if (r) print r "|" p }' "$STATE/runs.log"
}

cmd_plan() {
  load_assessment
  local size="${SIZE_BYTES:-0}" thr_bps thr_src m
  m="$(measured_throughput)"
  if [ -n "$m" ]; then
    thr_bps="${m%%|*}"; thr_src="measured in the last '${m##*|}' run"
  else
    thr_bps=$(( THROUGHPUT_MBPS * 1048576 )); thr_src="assumed THROUGHPUT_MBPS=$THROUGHPUT_MBPS (no test run yet)"
  fi
  [ "$thr_bps" -gt 0 ] || thr_bps=1
  local fl_min fl_margin_min cut_full_min
  fl_min="$(ceil_div "$size" $(( thr_bps * 60 )))"; [ "$fl_min" -ge 1 ] || fl_min=1
  fl_margin_min=$(( fl_min * (100 + MARGIN_PCT) / 100 ))
  cut_full_min=$(( fl_margin_min + VALIDATE_MINUTES + SWITCH_MINUTES ))

  local strategy reason
  local -a pblock=() pwarn=()
  while IFS= read -r m; do [ -z "$m" ] || pblock+=("$m"); done < "$STATE/blockers.txt"

  if [ "$PURPOSE" = replication ]; then
    strategy="full-load+cdc"; reason="the purpose is continuous replication"
  elif [ "$cut_full_min" -le "$DOWNTIME_MINUTES" ]; then
    strategy="full-load"; reason="a full load with ${MARGIN_PCT}% margin plus validation and switch (~${cut_full_min} min) fits in the ${DOWNTIME_MINUTES}-minute window"
  else
    strategy="full-load+cdc"; reason="a full load alone (~${cut_full_min} min with margin) does not fit the ${DOWNTIME_MINUTES}-minute window: load in advance, keep in sync with CDC, cut over in minutes"
  fi
  [ -z "${OPT_STRATEGY:-}" ] || { strategy="$OPT_STRATEGY"; reason="forced with --strategy"; }

  if is_xengine && [ "$strategy" = "full-load+cdc" ]; then
    if [ "$PURPOSE" = replication ]; then
      pblock+=("PURPOSE=replication across engines ($SRC_ENGINE → $TGT_ENGINE) needs a cross-engine CDC pipeline (e.g. Debezium + a sink connector); this tool moves data with a full load only.")
    else
      pblock+=("Cross-engine full load needs ~${cut_full_min} min with margin, more than the ${DOWNTIME_MINUTES}-minute window, and there is no cross-engine CDC. Options: a longer window, less data (EXCLUDE_DATA_TABLES / archiving), more JOBS, or a CDC pipeline such as Debezium.")
    fi
    strategy="full-load"; reason="cross-engine migrations are full load only"
  fi

  if [ "$strategy" = "full-load+cdc" ] && [ "${CDC_READY:-no}" != yes ]; then
    pblock+=("The plan needs CDC but the source is not ready for it — fix the CDC issues listed below (or accept a longer downtime window).")
  fi

  # Log retention needed while the initial copy runs and CDC catches up.
  local retain=""
  if [ "$strategy" = "full-load+cdc" ] && [ -n "${LOG_BYTES_PER_HOUR:-}" ]; then
    retain=$(( LOG_BYTES_PER_HOUR * (fl_margin_min / 60 + 1 + 24) ))
  fi
  if [ "$strategy" = "full-load+cdc" ] && [ -z "${LOG_BYTES_PER_HOUR:-}" ]; then
    pwarn+=("Transaction log generation was not measured; size the source's free disk for retained WAL/binlog from monitoring (e.g. CloudWatch TransactionLogsGeneration) at peak.")
  fi

  # Schedule, working back from the deadline with a week of buffer.
  local today d_test d_tune d_reh d_cut sched_ok=yes
  today="$(date +%F)"
  if [ -n "$DEADLINE" ]; then
    d_cut="$(date_add "$DEADLINE" -7)"; d_reh="$(date_add "$d_cut" -7)"
    d_tune="$(date_add "$d_reh" -5)";   d_test="$(date_add "$d_tune" -5)"
    if [ "$(date_days_between "$today" "$d_test")" -lt 0 ]; then
      sched_ok=no
      pwarn+=("The deadline $DEADLINE leaves less than the recommended ~24 days for test → tuning → rehearsal → cutover with a week of buffer. Compress the phases knowingly, or move the deadline.")
    fi
  else
    d_test="$(date_add "$today" 3)"; d_tune="$(date_add "$d_test" 5)"; d_reh="$(date_add "$d_tune" 5)"; d_cut="$(date_add "$d_reh" 7)"
    pwarn+=("No DEADLINE set: the dates below are only a suggested pace from today.")
  fi

  cat > "$STATE/plan.env" <<EOF
STRATEGY=$strategy
FULL_LOAD_MINUTES=$fl_min
THROUGHPUT_BPS=$thr_bps
PLANNED_AT=$(date -u +%FT%TZ)
EOF

  local f="$STATE/plan.md" b
  {
    echo "# Migration plan — $MIGRATION_NAME"
    echo
    echo "Generated $(date -u +%FT%TZ) by \`$PROG plan\` from \`assessment.md\`. Re-run after every test migration: the estimates switch from assumed to **measured** throughput automatically."
    echo
    echo "## Decision"
    echo
    echo "**Strategy: \`$strategy\`** — $reason."
    echo
    echo "| Input | Value |"
    echo "|---|---|"
    echo "| Data to move | $(hb "$size") |"
    echo "| Throughput | $(hb "$thr_bps")/s — $thr_src |"
    echo "| Full load estimate | ~$fl_min min (~$fl_margin_min min with ${MARGIN_PCT}% margin) |"
    echo "| Acceptable downtime | $DOWNTIME_MINUTES min |"
    if [ "$strategy" = full-load ]; then
      echo "| Expected downtime | ~$cut_full_min min (load + ${VALIDATE_MINUTES} validate + ${SWITCH_MINUTES} switch) |"
    else
      echo "| Expected downtime | ~$(( VALIDATE_MINUTES + SWITCH_MINUTES + 5 )) min (catch-up + validate + switch) |"
      echo "| Acceptable replication lag | $MAX_LAG_SECONDS s |"
      [ -z "$retain" ] || echo "| Log retention needed on source | ≥ $(hb "$retain") of WAL/binlog (initial copy + 24h buffer at the sampled rate) |"
    fi
    echo
    echo "## Blockers — resolve before the test migration"
    echo
    if [ "${#pblock[@]}" -eq 0 ]; then echo "- none"; else for b in "${pblock[@]}"; do echo "- $b"; done; fi
    if [ "$strategy" = "full-load+cdc" ] && [ -s "$STATE/cdc_issues.txt" ]; then
      echo; echo "CDC issues:"; echo; bullets "$STATE/cdc_issues.txt"
    fi
    echo
    echo "## Warnings"
    echo
    { cat "$STATE/warnings.txt"; [ "${#pwarn[@]}" -eq 0 ] || printf '%s\n' "${pwarn[@]}"; } > "$STATE/.w"; bullets "$STATE/.w"; rm -f "$STATE/.w"
    echo
    echo "## Schedule"
    echo
    echo "| Phase | Target date | Command | Exit criteria |"
    echo "|---|---|---|---|"
    echo "| 1. Requirements & plan | $today | \`assess\`, \`plan\` | No blockers; owners agree downtime, lag and deadline |"
    echo "| 2. Test migration | $d_test | \`run --phase test\` | Validation passes; timings recorded |"
    echo "| 3. Tuning & plan review | $d_tune | \`plan\` (re-run), adjust \`JOBS\`, excluded data, instance sizes | Measured estimate fits the window with margin |"
    echo "| 4. Rehearsal | $d_reh | \`run --phase rehearsal\` against a production-sized copy | Whole runbook timed end to end, within the window |"
    echo "| 5. Production cutover | $d_cut | \`cutover\` | Validation passes; apps switched; source kept read-only as fallback |"
    [ -z "$DEADLINE" ] || { echo; echo "Deadline: **$DEADLINE** (cutover planned one week earlier as buffer for a retry). Schedule realistic: **$sched_ok**."; }
    echo
    echo "## Runbook"
    echo
    if [ "$strategy" = full-load ]; then
      cat <<EOF
Cutover day (inside the $DOWNTIME_MINUTES-minute window):

1. Announce the window; stop application writes to the source.
2. \`$PROG cutover $CONF\` — full load into the empty production target, then validation.
3. Create users/roles/grants on the target; switch application connection strings.
4. Smoke-test the application; keep the source untouched (read-only) as the fallback.
EOF
    else
      cat <<EOF
Days before cutover:

1. \`$PROG full-load $CONF --phase cutover\` — $( [ "$SRC_ENGINE" = postgres ] && echo "schema only; the data is copied by the subscription" || echo "full dump with the binlog position recorded" ).
2. \`$PROG cdc start $CONF\` and watch \`$PROG cdc status $CONF\` until it reports caught up and stays within $MAX_LAG_SECONDS s.
3. Freeze schema changes on the source until cutover.

Cutover day:

1. Stop application writes to the source.
2. \`$PROG cutover $CONF\` — waits for zero lag, copies sequences, validates, stops CDC.
3. Create users/roles/grants on the target; switch application connection strings.
4. Smoke-test; keep the source read-only as the fallback.
EOF
    fi
    cat <<EOF

## Rollback

Until applications write to the target, rollback is simply "keep using the source". After the switch, writes made to the target do not exist on the source: decide in advance how long the fallback window is and what happens to those writes.

## Things to schedule around

- Managed-service maintenance windows and backup windows (RDS/Aurora/Atlas) on both sides: keep them away from the full load — a load interrupted mid-table must be restarted.
- Engine end-of-support dates: migrating onto a version that leaves support during the project means planning the upgrade too.$( [ "$PURPOSE" = replication ] && echo "
- Long-term replication: include engine upgrade tests and a lag alert at $MAX_LAG_SECONDS s from the start." )
EOF
  } > "$f"
  ok "plan written: $f"
  info "strategy: $strategy — $reason"
  [ "${#pblock[@]}" -eq 0 ] || { warn "${#pblock[@]} blocker(s) — see the plan"; printf '     - %s\n' "${pblock[@]}" >&2; }
}

# ── full load ───────────────────────────────────────────────────────────────

target_is_empty() {
  local n
  case "$TGT_ENGINE" in
    postgres)
      local sl; sl="$(pg_schema_list)"
      if is_xengine; then x_init; sl="'$TGT_SCHEMA'"; fi
      n="$(q tgt "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r','p','v','m','S','f') AND n.nspname IN ($sl)")" ;;
    mariadb|mysql) n="$(QDB='' q tgt "SELECT (SELECT count(*) FROM information_schema.tables WHERE table_schema = '$TGT_DB') + (SELECT count(*) FROM information_schema.routines WHERE routine_schema = '$TGT_DB')")" ;;
    mongodb) n="$(js tgt 'print(db.getCollectionNames().filter(n => !n.startsWith("system.")).length)')" ;;
  esac
  [ "$n" = 0 ]
}

full_load_postgres() {
  local mode="$1" s args="" own="--no-owner --no-privileges" lo
  [ "$PG_KEEP_OWNERSHIP" = true ] && own=""
  for s in $SCHEMAS; do args+=" -n '$s'"; done
  args+=" -e '*'"   # with -n, extensions are left out unless asked for
  lo="$(q src "SELECT count(*) FROM pg_largeobject_metadata")"
  [ "$lo" = 0 ] || [ "$mode" = schema ] || args+=" -b"
  if [ "$mode" = schema ]; then
    args+=" --schema-only"
  else
    for s in $EXCLUDE_DATA_TABLES; do args+=" --exclude-table-data='$s'"; done
  fi

  local errf="$STATE/load.err" st
  : > "$errf"
  set +e
  if [ "$JOBS" -gt 1 ] && [ "$mode" = full ]; then
    info "parallel: pg_dump -Fd -j $JOBS and pg_restore -j $JOBS through a temporary directory (needs free space ≈ the dump size $( [ "$CLIENT_MODE" = docker ] && echo 'inside the container' || echo 'in $TMPDIR' ))"
    use tgt
    export DBM_H2="$DBM_H" DBM_P2="$DBM_P" DBM_U2="$DBM_U" DBM_D2="$DBM_D" DBM_PW2="$PGPASSWORD" DBM_TLS2="$PGSSLMODE" DBM_CA2="$DBM_CA"
    use src
    # The target gets its own root certificate (or none): with a root file
    # present, libpq would check the target against the SOURCE's CA.
    client postgres "d=\$(mktemp -d); trap 'rm -rf \"\$d\" \"\$DBM_CAF\" \"\$DBM_CAF2\"' EXIT
      pg_dump -h \"\$DBM_H\" -p \"\$DBM_P\" -U \"\$DBM_U\" -d \"\$DBM_D\" -Fd -j $JOBS -f \"\$d/dump\" --strict-names $args || exit 90
      PGPASSWORD=\"\$DBM_PW2\" PGSSLMODE=\"\$DBM_TLS2\" PGSSLROOTCERT=\"\${DBM_CAF2:-/nonexistent}\" pg_restore -h \"\$DBM_H2\" -p \"\$DBM_P2\" -U \"\$DBM_U2\" -d \"\$DBM_D2\" -j $JOBS $own \"\$d/dump\"" 2> "$errf"
    st=$?
    [ "$st" -ne 90 ] || { set -e; cat "$errf" >&2; die "pg_dump failed on the source"; }
  else
    ( use src; client postgres "pg_dump -h \"\$DBM_H\" -p \"\$DBM_P\" -U \"\$DBM_U\" -d \"\$DBM_D\" -Fc --strict-names $args" ) 2> "$STATE/dump.err" \
      | ( use tgt; client postgres "pg_restore -h \"\$DBM_H\" -p \"\$DBM_P\" -U \"\$DBM_U\" -d \"\$DBM_D\" $own" ) 2> "$errf"
    local -a ps=("${PIPESTATUS[@]}")
    [ "${ps[0]}" -eq 0 ] || { set -e; cat "$STATE/dump.err" >&2; die "pg_dump failed on the source (see above)"; }
    st="${ps[1]}"
  fi
  set -e
  # pg_restore keeps going past errors and exits 1 at the end. Some are
  # expected on any target (the schema or extension already exists, or the
  # target user may not COMMENT ON an extension it does not own); anything
  # else is a real failure.
  if [ "$st" -ne 0 ]; then
    local real
    real="$(grep -E '^pg_restore: error:' "$errf" | grep -Ev '(schema|extension) "[^"]+" already exists|must be owner of extension|unrecognized configuration parameter "transaction_timeout"' || true)"
    if [ -n "$real" ]; then
      printf '%s\n' "$real" >&2
      die "pg_restore reported errors (full log: $errf)"
    fi
    info "pg_restore: only expected 'already exists' errors (logged in $errf)"
  fi
}

full_load_mysqlish() {
  local mode="$1" want_coords="$2"
  local dump_bin flags coords="$STATE/binlog.coords" s
  rm -f "$coords"
  if [ "$SRC_ENGINE" = mariadb ]; then dump_bin=mariadb-dump; else dump_bin=mysqldump; fi
  flags="--single-transaction --quick --routines --triggers --events --hex-blob --default-character-set=utf8mb4"
  [ "$SRC_ENGINE" = mysql ] && flags+=" --set-gtid-purged=OFF --column-statistics=0"
  if [ "$want_coords" = 1 ]; then
    if [ "$SRC_ENGINE" = mariadb ]; then flags+=" --master-data=2"; else flags+=" --source-data=2"; fi
  fi
  local mysql_excl=""
  for s in $EXCLUDE_DATA_TABLES; do
    if [ "$SRC_ENGINE" = mariadb ]; then flags+=" --ignore-table-data='$SRC_DB.$s'"
    else flags+=" --ignore-table='$SRC_DB.$s'"; mysql_excl+=" '$s'"; fi
  done
  [ "$mode" = full ] || flags+=" --no-data"

  local cs="${SRC_ENCODING:-utf8mb4}" coll="${SRC_COLLATION:-}"
  [ "$TGT_ENGINE" = "$SRC_ENGINE" ] || coll=""
  QDB='' q tgt "CREATE DATABASE IF NOT EXISTS \`$TGT_DB\` CHARACTER SET $cs${coll:+ COLLATE $coll}" >/dev/null

  local load_cmd
  if [ "$TGT_ENGINE" = mariadb ]; then load_cmd='mariadb $DBM_TLS -h "$DBM_H" -P "$DBM_P" -u "$DBM_U" --default-character-set=utf8mb4 "$DBM_D"'
  else load_cmd='mysql $DBM_TLS -h "$DBM_H" -P "$DBM_P" -u "$DBM_U" --default-character-set=utf8mb4 "$DBM_D"'; fi

  set +e
  ( use src; client "$SRC_ENGINE" "$dump_bin \$DBM_TLS -h \"\$DBM_H\" -P \"\$DBM_P\" -u \"\$DBM_U\" $flags \"\$DBM_D\"" ) 2> "$STATE/dump.err" \
    | LC_ALL=C awk -v f="$coords" -v strip="$STRIP_DEFINERS" '
        !done && /^-- CHANGE (MASTER|REPLICATION SOURCE) TO/ { print > f; close(f); done = 1 }
        strip == "true" && /DEFINER=`/ { gsub(/DEFINER=`[^`]*`@`[^`]*`/, "") }
        { print }' \
    | ( use tgt; client "$TGT_ENGINE" "$load_cmd" ) 2> "$STATE/load.err"
  local -a ps=("${PIPESTATUS[@]}")
  set -e
  [ "${ps[0]}" -eq 0 ] || { cat "$STATE/dump.err" >&2; die "$dump_bin failed on the source (see above)"; }
  [ "${ps[2]}" -eq 0 ] || { cat "$STATE/load.err" >&2; die "loading into the target failed (see above)"; }

  if [ -n "$mysql_excl" ] && [ "$mode" = full ]; then
    info "creating the excluded tables empty"
    ( use src; client mysql "mysqldump \$DBM_TLS -h \"\$DBM_H\" -P \"\$DBM_P\" -u \"\$DBM_U\" --no-data --set-gtid-purged=OFF --column-statistics=0 \"\$DBM_D\" $mysql_excl" ) \
      | ( use tgt; client "$TGT_ENGINE" "$load_cmd" ) || die "creating the excluded tables failed"
  fi
  if [ "$want_coords" = 1 ]; then
    [ -s "$coords" ] || die "the dump did not record a binlog position (is log_bin on, and does $SRC_USER have RELOAD?)"
    ok "binlog position recorded: $(sed 's/^-- //' "$coords")"
  fi
}

full_load_mongodb() {
  local excl="" s
  for s in $EXCLUDE_DATA_TABLES; do excl+=" --excludeCollection='$s'"; done
  set +e
  ( use src; client mongodb "$MCFG mongodump --config=\"\$c\" --db=\"\$DBM_D\" --archive --gzip $excl" ) 2> "$STATE/dump.err" \
    | ( use tgt; client mongodb "$MCFG mongorestore --config=\"\$c\" --archive --gzip --nsFrom=\"\$DBM_SRCDB.*\" --nsTo=\"\$DBM_D.*\" --stopOnError --numInsertionWorkersPerCollection=$JOBS" ) 2> "$STATE/load.err"
  local -a ps=("${PIPESTATUS[@]}")
  set -e
  [ "${ps[0]}" -eq 0 ] || { cat "$STATE/dump.err" >&2; die "mongodump failed on the source (see above)"; }
  [ "${ps[1]}" -eq 0 ] || { tail -20 "$STATE/load.err" >&2; die "mongorestore failed on the target (full log: $STATE/load.err)"; }
}

cmd_full_load() {
  require_supported_pair
  load_assessment
  load_plan
  local phase="${OPT_PHASE:-test}" mode=full coords=0
  if is_xengine; then
    log "full load ($phase, cross-engine): $SRC_ENGINE $SRC_HOST/$SRC_DB → $TGT_ENGINE $TGT_HOST/$TGT_DB"
    target_is_empty || die "the target already contains objects in the migrated schema/database. Load only into an empty target (drop it and recreate it for a re-test)."
    local t0 secs; t0="$(now)"
    echo full > "$STATE/load.mode"; echo "$phase" > "$STATE/phase"
    record_run "$phase" "full-load-started" 0 0 "-"
    x_full_load
    secs=$(( $(now) - t0 )); [ "$secs" -ge 1 ] || secs=1
    record_run "$phase" "full-load" "$secs" "${SIZE_BYTES:-0}" ok
    ok "full load done in ${secs}s ($(hb $(( ${SIZE_BYTES:-0} / secs )))/s)"
    return 0
  fi
  if [ "$STRATEGY" = "full-load+cdc" ]; then
    case "$SRC_ENGINE" in
      postgres) mode=schema ;;
      mariadb|mysql) homogeneous || die "CDC between $SRC_ENGINE and $TGT_ENGINE is not supported — use --strategy full-load"; coords=1 ;;
      mongodb) die "the plan needs CDC, which this tool cannot do for MongoDB (see plan.md) — use --strategy full-load to accept a full write freeze" ;;
    esac
  fi

  log "full load ($phase): $SRC_ENGINE $SRC_HOST/$SRC_DB → $TGT_ENGINE $TGT_HOST/$TGT_DB"
  if ! target_is_empty; then
    die "the target already contains objects in the migrated schema/database. Load only into an empty target (drop it and recreate it for a re-test)."
  fi
  [ "$mode" = schema ] && info "strategy $STRATEGY: copying the SCHEMA only — the subscription copies the data (cdc start)"
  [ "$coords" = 1 ] && info "strategy $STRATEGY: full dump, recording the binlog position for CDC"

  local t0 secs
  t0="$(now)"
  echo "$mode" > "$STATE/load.mode"
  record_run "$phase" "full-load-started" 0 0 "-"
  case "$SRC_ENGINE" in
    postgres) full_load_postgres "$mode" ;;
    mariadb|mysql) full_load_mysqlish "$mode" "$coords" ;;
    mongodb) full_load_mongodb ;;
  esac
  secs=$(( $(now) - t0 )); [ "$secs" -ge 1 ] || secs=1
  if [ "$mode" = full ]; then
    record_run "$phase" "full-load" "$secs" "${SIZE_BYTES:-0}" ok
    ok "full load done in ${secs}s ($(hb $(( ${SIZE_BYTES:-0} / secs )))/s)"
  else
    record_run "$phase" "schema-load" "$secs" 0 ok
    ok "schema loaded in ${secs}s"
  fi
  echo "$phase" > "$STATE/phase"
}

# ── CDC ─────────────────────────────────────────────────────────────────────

pg_conninfo_val() { local v="${1//\\/\\\\}"; v="${v//\'/\\\'}"; printf "'%s'" "$v"; }
sql_lit()         { printf '%s' "${1//\'/\'\'}"; }
my_lit()          { local v="${1//\\/\\\\}"; printf '%s' "${v//\'/\\\'}"; }

cdc_start_postgres() {
  local row
  [ "$(cat "$STATE/load.mode" 2>/dev/null)" = schema ] \
    || die "CDC copies the data itself, so the target must have been loaded with the SCHEMA only (strategy full-load+cdc). Empty the target and run full-load with that plan."
  [ "$(q src "SELECT current_setting('wal_level')")" = logical ] || die "source wal_level is not 'logical' — see the CDC issues in assessment.md"
  [ -z "$(q src "SELECT 1 FROM pg_publication WHERE pubname = '$PUB'")" ] || die "publication $PUB already exists on the source — CDC is already started (cdc status / cdc stop)"
  local sl ex
  sl="$(pg_schema_list)"; ex="$(pg_excl_list)"
  row="$(q src "SELECT string_agg(format('%I.%I', n.nspname, c.relname), ', ') FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = 'r' AND n.nspname IN ($sl) AND (c.relreplident = 'n' OR (c.relreplident = 'd' AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.conrelid = c.oid AND k.contype = 'p'))) AND n.nspname || '.' || c.relname NOT IN ($ex)")"
  [ -z "$row" ] || die "these tables have no primary key / replica identity; publishing them would make UPDATE/DELETE FAIL ON THE SOURCE: $row. Fix with ALTER TABLE … REPLICA IDENTITY FULL (or add a primary key), or list them in EXCLUDE_DATA_TABLES."
  local tables
  tables="$(q src "SELECT string_agg(format('%I.%I', n.nspname, c.relname), ', ') FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = 'r' AND n.nspname IN ($sl) AND n.nspname || '.' || c.relname NOT IN ($ex)")"
  [ -n "$tables" ] || die "no tables to publish"

  # The subscription is a connection FROM THE TARGET SERVER to the source:
  # encrypted (REPL_SSL=require, default) and, with REPL_SSL_CA_PATH — a path
  # on the target server — certificate- and hostname-verified.
  local pw="${REPL_PASSWORD:-${SRC_PASSWORD:-}}" ssl
  case "$REPL_SSL" in
    verify)  ssl="verify-full sslrootcert=$(pg_conninfo_val "$REPL_SSL_CA_PATH")" ;;
    require) ssl=require ;;
    disable) ssl=disable ;;
  esac
  local conn="host=$(pg_conninfo_val "$REPL_HOST") port=$REPL_PORT dbname=$(pg_conninfo_val "$SRC_DB") user=$(pg_conninfo_val "$REPL_USER") password=$(pg_conninfo_val "$pw") sslmode=$ssl"

  log "source: CREATE PUBLICATION $PUB"
  q src "CREATE PUBLICATION $PUB FOR TABLE $tables" >/dev/null
  log "target: CREATE SUBSCRIPTION $PUB (connects to $REPL_HOST:$REPL_PORT FROM THE TARGET SERVER)"
  if ! q tgt "CREATE SUBSCRIPTION $PUB CONNECTION '$(sql_lit "$conn")' PUBLICATION $PUB WITH (copy_data = true)" >/dev/null; then
    q src "DROP PUBLICATION IF EXISTS $PUB" >/dev/null || true
    die "creating the subscription failed. The TARGET server must reach $REPL_HOST:$REPL_PORT (set REPL_HOST if the source has a different address from there), and $TGT_USER needs superuser / rds_superuser / pg_create_subscription. The publication was removed again."
  fi
  info "note: the connection string (with password) is stored in the target's pg_subscription catalog until cdc stop"
}

cdc_start_mysqlish() {
  homogeneous || die "CDC between $SRC_ENGINE and $TGT_ENGINE is not supported"
  [ "$SRC_DB" = "$TGT_DB" ] || die "CDC needs SRC_DB and TGT_DB to be the same name"
  local coords="$STATE/binlog.coords" file pos
  [ -s "$coords" ] || die "no binlog position recorded — run full-load with the full-load+cdc plan first"
  file="$(sed -n "s/.*LOG_FILE='\([^']*\)'.*/\1/p" "$coords")"
  pos="$(sed -n 's/.*LOG_POS=\([0-9]*\).*/\1/p' "$coords")"
  [ -n "$file" ] && [ -n "$pos" ] || die "could not parse $coords"
  local pw="${REPL_PASSWORD:-${SRC_PASSWORD:-}}" sql
  local h; h="$(my_lit "$REPL_HOST")"; local u; u="$(my_lit "$REPL_USER")"; local p; p="$(my_lit "$pw")"
  # The replica thread is a connection FROM THE TARGET SERVER to the source:
  # TLS on unless REPL_SSL=disable; certificate-verified with REPL_SSL_CA_PATH.
  local ssl_m="" ssl_s="" ssl_rds=1
  case "$REPL_SSL" in
    require) ssl_m=", MASTER_SSL=1, MASTER_SSL_VERIFY_SERVER_CERT=0"; ssl_s=", SOURCE_SSL=1" ;;
    verify)  ssl_m=", MASTER_SSL=1, MASTER_SSL_CA='$(my_lit "$REPL_SSL_CA_PATH")', MASTER_SSL_VERIFY_SERVER_CERT=1"
             ssl_s=", SOURCE_SSL=1, SOURCE_SSL_CA='$(my_lit "$REPL_SSL_CA_PATH")', SOURCE_SSL_VERIFY_SERVER_CERT=1" ;;
    disable) ssl_m=", MASTER_SSL=0"; ssl_s=", SOURCE_SSL=0, GET_SOURCE_PUBLIC_KEY=1"; ssl_rds=0 ;;
  esac
  if [ "$TGT_MANAGED" = rds ]; then
    # last argument of the RDS procedure: ssl_encryption
    if [ "$TGT_ENGINE" = mariadb ]; then
      sql="CALL mysql.rds_set_external_master('$h', $REPL_PORT, '$u', '$p', '$file', $pos, $ssl_rds); CALL mysql.rds_start_replication;"
    else
      sql="CALL mysql.rds_set_external_source('$h', $REPL_PORT, '$u', '$p', '$file', $pos, $ssl_rds); CALL mysql.rds_start_replication;"
    fi
    warn "RDS target: set replicate-do-db=$TGT_DB in the target's parameter group, or every database on the source is replicated"
  elif [ "$TGT_ENGINE" = mariadb ]; then
    sql="STOP SLAVE; SET GLOBAL replicate_do_db = '$(my_lit "$TGT_DB")'; CHANGE MASTER TO MASTER_HOST='$h', MASTER_PORT=$REPL_PORT, MASTER_USER='$u', MASTER_PASSWORD='$p', MASTER_LOG_FILE='$file', MASTER_LOG_POS=$pos$ssl_m; START SLAVE;"
  else
    sql="STOP REPLICA; CHANGE REPLICATION FILTER REPLICATE_DO_DB = (\`$TGT_DB\`); CHANGE REPLICATION SOURCE TO SOURCE_HOST='$h', SOURCE_PORT=$REPL_PORT, SOURCE_USER='$u', SOURCE_PASSWORD='$p', SOURCE_LOG_FILE='$file', SOURCE_LOG_POS=$pos$ssl_s; START REPLICA;"
  fi
  log "target: start replication from $file:$pos (the TARGET server connects to $REPL_HOST:$REPL_PORT)"
  q tgt "$sql" >/dev/null
}

cmd_cdc() {
  local sub="${1:-}"
  ! is_xengine || die "there is no CDC between different engines ($SRC_ENGINE → $TGT_ENGINE) in this tool — cross-engine migrations are full load only"
  case "$sub" in
    start)
      load_assessment
      case "$SRC_ENGINE" in
        postgres) cdc_start_postgres ;;
        mariadb|mysql) cdc_start_mysqlish ;;
        mongodb) die "no native CDC for MongoDB in this tool — use mongosync or AWS DMS (see plan.md)" ;;
      esac
      now > "$STATE/cdc.started"; rm -f "$STATE/cdc.synced"
      ok "CDC started. Watch it with: $PROG cdc status $CONF   (or: $PROG cdc wait $CONF)" ;;
    status) cdc_status; return $? ;;
    wait)   cdc_wait "${OPT_TIMEOUT:-0}" ;;
    stop)   cdc_stop ;;
    *) die "usage: $PROG cdc <start|status|wait|stop> <config>" ;;
  esac
}

# cdc_status — prints the state; returns 0 when caught up, 2 when not yet.
cdc_status() {
  local caught=1
  case "$SRC_ENGINE" in
    postgres)
      local row pending total active lag age
      row="$(q tgt "SELECT count(*) FILTER (WHERE r.srsubstate <> 'r'), count(*) FROM pg_subscription s JOIN pg_subscription_rel r ON r.srsubid = s.oid WHERE s.subname = '$PUB'")"
      IFS='|' read -r pending total <<<"$row"
      [ "${total:-0}" -gt 0 ] || die "no subscription $PUB on the target — CDC is not running"
      row="$(q src "SELECT active::text, coalesce(pg_wal_lsn_diff(pg_current_wal_lsn(), confirmed_flush_lsn), 0)::bigint FROM pg_replication_slots WHERE slot_name = '$PUB'")"
      IFS='|' read -r active lag <<<"$row"
      age="$(q tgt "SELECT coalesce(extract(epoch FROM now() - latest_end_time)::int, -1) FROM pg_stat_subscription WHERE subname = '$PUB' AND relid IS NULL")"
      info "tables in initial copy: $pending of $total still copying"
      info "slot active: ${active:-missing}   lag: $(hb "${lag:-0}")   last message from source: ${age:-?}s ago"
      if [ "$pending" = 0 ] && [ "${active:-f}" = true ] && [ "${lag:-0}" -le "$CDC_MAX_LAG_BYTES" ]; then caught=0; fi
      if [ "$pending" = 0 ] && [ ! -f "$STATE/cdc.synced" ] && [ -f "$STATE/cdc.started" ]; then
        local secs=$(( $(now) - $(cat "$STATE/cdc.started") ))
        load_assessment
        record_run "$(cat "$STATE/phase" 2>/dev/null || echo test)" "initial-sync" "$secs" "${SIZE_BYTES:-0}" ok
        touch "$STATE/cdc.synced"
        ok "initial copy finished in ${secs}s — recorded for planning"
      fi ;;
    mariadb|mysql)
      local out io sqlr behind err
      if [ "$TGT_ENGINE" = mariadb ]; then out="$(qv tgt "SHOW SLAVE STATUS")"; else out="$(qv tgt "SHOW REPLICA STATUS")"; fi
      [ -n "$out" ] || die "replication is not configured on the target — CDC is not running"
      io="$(awk -F': ' '/(Slave|Replica)_IO_Running:/ {print $2}' <<<"$out")"
      sqlr="$(awk -F': ' '/(Slave|Replica)_SQL_Running:/ {print $2}' <<<"$out")"
      behind="$(awk -F': ' '/Seconds_Behind_(Master|Source):/ {print $2}' <<<"$out")"
      err="$(awk -F': ' '/Last_(IO_|SQL_)?Error: ./ {print $2}' <<<"$out" | head -1)"
      info "IO thread: $io   SQL thread: $sqlr   seconds behind: $behind"
      [ -z "$err" ] || warn "last error: $err"
      if [ "$io" = Yes ] && [ "$sqlr" = Yes ] && [ "$behind" != NULL ] && [ "${behind:-999999}" -le "$MAX_LAG_SECONDS" ]; then caught=0; fi
      if [ "$caught" = 0 ] && [ ! -f "$STATE/cdc.synced" ] && [ -f "$STATE/cdc.started" ]; then
        touch "$STATE/cdc.synced"
        record_run "$(cat "$STATE/phase" 2>/dev/null || echo test)" "cdc-caught-up" "$(( $(now) - $(cat "$STATE/cdc.started") ))" 0 ok
      fi ;;
    mongodb) die "no CDC for MongoDB in this tool" ;;
  esac
  if [ "$caught" = 0 ]; then ok "caught up"; return 0; fi
  info "not caught up yet"; return 2
}

cdc_wait() { # cdc_wait <timeout minutes, 0 = forever>
  local limit="$1" t0; t0="$(now)"
  while true; do
    if cdc_status; then return 0; fi
    if [ "$limit" -gt 0 ] && [ $(( $(now) - t0 )) -ge $(( limit * 60 )) ]; then
      die "CDC did not catch up within $limit minutes"
    fi
    sleep 15
  done
}

cdc_stop() {
  log "stopping CDC"
  case "$SRC_ENGINE" in
    postgres)
      if [ -n "$(q tgt "SELECT 1 FROM pg_subscription WHERE subname = '$PUB'")" ]; then
        q tgt "DROP SUBSCRIPTION $PUB" >/dev/null || die "DROP SUBSCRIPTION failed on the target"
        ok "subscription dropped on the target"
      fi
      q src "DROP PUBLICATION IF EXISTS $PUB" >/dev/null && ok "publication dropped on the source"
      # A slot left behind holds WAL on the source forever and eventually fills its disk.
      if [ -n "$(q src "SELECT 1 FROM pg_replication_slots WHERE slot_name = '$PUB'")" ]; then
        q src "SELECT pg_drop_replication_slot('$PUB')" >/dev/null && ok "replication slot $PUB dropped on the source"
      fi ;;
    mariadb|mysql)
      local sql
      if [ "$TGT_MANAGED" = rds ]; then
        if [ "$TGT_ENGINE" = mariadb ]; then sql="CALL mysql.rds_stop_replication; CALL mysql.rds_reset_external_master;"
        else sql="CALL mysql.rds_stop_replication; CALL mysql.rds_reset_external_source;"; fi
      elif [ "$TGT_ENGINE" = mariadb ]; then sql="STOP SLAVE; RESET SLAVE ALL; SET GLOBAL replicate_do_db = '';"
      else sql="STOP REPLICA; RESET REPLICA ALL; CHANGE REPLICATION FILTER REPLICATE_DO_DB = ();"; fi
      q tgt "$sql" >/dev/null && ok "replication stopped and reset on the target" ;;
    mongodb) die "no CDC for MongoDB in this tool" ;;
  esac
  rm -f "$STATE/cdc.started"
}

# ── validate ────────────────────────────────────────────────────────────────

# table_list <side> — one quoted table name per line
table_list() {
  case "$C_ENGINE_OF" in
    postgres) q "$1" "SELECT format('%I.%I', n.nspname, c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = 'r' AND n.nspname IN ($(pg_schema_list)) ORDER BY 1" ;;
    mariadb|mysql) q "$1" "SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE' ORDER BY 1" ;;
  esac
}

# counts <side> <file with table names> — "name|count[/checksum]" per table
counts() {
  local side="$1" list="$2" sql="" n=0 t lit
  local chk="${OPT_CHECKSUM:-0}"
  flush() {
    [ -n "$sql" ] || return 0
    # Fixed session time zone: TIMESTAMP values render in it.
    case "$C_ENGINE_OF" in mariadb|mysql) sql="SET SESSION time_zone = '+00:00'; $sql" ;; esac
    q "$side" "$sql"; sql=""; n=0
  }
  # MariaDB/MySQL content hash, as pt-table-checksum does it: MD5 of every
  # value in each row, folded with BIT_XOR into 128 bits — independent of row
  # order and storage format, constant memory. (CHECKSUM TABLE is NOT usable:
  # it hashes the engine's internal row buffer and differs between tables
  # holding identical data.) Column list taken from the source.
  if [ "$chk" = 1 ] && [ "$C_ENGINE_OF" != postgres ] && [ ! -s "$STATE/.cols" ]; then
    q src "SELECT table_name, column_name, data_type FROM information_schema.columns WHERE table_schema = DATABASE() ORDER BY table_name, ordinal_position" > "$STATE/.cols"
  fi
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    case "$C_ENGINE_OF" in
      postgres)
        lit="$(sql_lit "$t")"
        if [ "$chk" = 1 ]; then
          sql+="${sql:+ UNION ALL }SELECT '$lit', count(*)::text || '/' || coalesce(md5(string_agg(md5(x::text), '' ORDER BY md5(x::text))), '-') FROM $t x"
        else
          sql+="${sql:+ UNION ALL }SELECT '$lit', count(*)::text FROM $t"
        fi ;;
      mariadb|mysql)
        lit="$(my_lit "$t")"
        if [ "$chk" = 1 ]; then
          local row="" col dt v
          while IFS='|' read -r col dt; do
            case "$dt" in
              binary|varbinary|tinyblob|blob|mediumblob|longblob|geometry|point|linestring|polygon|multipoint|multilinestring|multipolygon|geometrycollection|geomcollection)
                v="HEX(\`${col//\`/\`\`}\`)" ;;
              *) v="CAST(\`${col//\`/\`\`}\` AS CHAR)" ;;
            esac
            # length-prefixed, so ('a#b','c') and ('a','b#c') cannot collide
            row+="${row:+, }IFNULL(CONCAT(LENGTH($v), ':', $v), 'N')"
          done < <(awk -F'|' -v t="$t" '$1 == t { print $2 "|" $3 }' "$STATE/.cols")
          sql+="${sql:+ UNION ALL }SELECT '$lit', CONCAT(COUNT(*), '/',
            LPAD(HEX(BIT_XOR(CAST(CONV(SUBSTRING(h, 1, 16), 16, 10) AS UNSIGNED))), 16, '0'),
            LPAD(HEX(BIT_XOR(CAST(CONV(SUBSTRING(h, 17, 16), 16, 10) AS UNSIGNED))), 16, '0'))
            FROM (SELECT MD5(CONCAT_WS('#', $row)) h FROM \`${t//\`/\`\`}\`) x"
        else
          sql+="${sql:+ UNION ALL }SELECT '$lit', COUNT(*) FROM \`${t//\`/\`\`}\`"
        fi ;;
    esac
    n=$(( n + 1 ))
    [ "$n" -lt 300 ] || flush
  done < "$list"
  flush
}

objects() { # objects <side> — "kind|count" lines
  case "$C_ENGINE_OF" in
    postgres)
      local sl; sl="$(pg_schema_list)"
      q "$1" "SELECT 'views', count(*) FROM pg_views WHERE schemaname IN ($sl) UNION ALL SELECT 'materialized views', count(*) FROM pg_matviews WHERE schemaname IN ($sl) UNION ALL SELECT 'functions', count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE n.nspname IN ($sl) UNION ALL SELECT 'sequences', count(*) FROM pg_sequences WHERE schemaname IN ($sl) UNION ALL SELECT 'indexes', count(*) FROM pg_indexes WHERE schemaname IN ($sl) UNION ALL SELECT 'constraints', count(*) FROM pg_constraint k JOIN pg_namespace n ON n.oid = k.connamespace WHERE n.nspname IN ($sl) UNION ALL SELECT 'triggers', count(*) FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid JOIN pg_namespace n ON n.oid = c.relnamespace WHERE NOT t.tgisinternal AND n.nspname IN ($sl)" ;;
    mariadb|mysql)
      q "$1" "SELECT 'views', count(*) FROM information_schema.views WHERE table_schema = DATABASE() UNION ALL SELECT 'routines', count(*) FROM information_schema.routines WHERE routine_schema = DATABASE() UNION ALL SELECT 'triggers', count(*) FROM information_schema.triggers WHERE trigger_schema = DATABASE() UNION ALL SELECT 'events', count(*) FROM information_schema.events WHERE event_schema = DATABASE() UNION ALL SELECT 'indexes', count(DISTINCT table_name, index_name) FROM information_schema.statistics WHERE table_schema = DATABASE()" ;;
  esac
}

cmd_validate() {
  if is_xengine; then x_validate; return $?; fi
  local out="$STATE/validation.md" fail=0 n t s d
  C_ENGINE_OF="$SRC_ENGINE"
  log "validating: row counts$( [ "${OPT_CHECKSUM:-0}" = 1 ] && echo ' and checksums' ) and object counts, source vs target"
  local sa="$STATE/.src" ta="$STATE/.tgt"
  : > "$sa"; : > "$ta"; rm -f "$STATE/.cols"

  if [ "$SRC_ENGINE" = mongodb ]; then
    local jsc
    jsc='const h = '"$( [ "${OPT_CHECKSUM:-0}" = 1 ] && echo 'db.runCommand({ dbHash: 1 }).collections || {}' || echo '{}' )"';
      db.getCollectionInfos({ type: "collection" }).map(c => c.name).filter(n => !n.startsWith("system.")).sort()
        .forEach(n => print(n + "|" + db.getCollection(n).countDocuments({}) + (h[n] ? "/" + h[n] : "") + "|" + db.getCollection(n).getIndexes().length));'
    js src "$jsc" > "$sa"; js tgt "$jsc" > "$ta"
  else
    table_list src > "$STATE/.tables.src"; table_list tgt > "$STATE/.tables.tgt"
    comm -12 <(sort "$STATE/.tables.src") <(sort "$STATE/.tables.tgt") > "$STATE/.tables.both"
    counts src "$STATE/.tables.both" | sort > "$sa"
    counts tgt "$STATE/.tables.both" | sort > "$ta"
  fi

  {
    echo "# Validation — $MIGRATION_NAME"
    echo
    echo "Run $(date -u +%FT%TZ). $( [ "${OPT_CHECKSUM:-0}" = 1 ] && echo 'Row counts and content checksums.' || echo 'Row counts (add --checksum to compare content too).' )"
    echo
    echo "Counts are exact only when nothing is writing to the source, or CDC has caught up after writes stopped."
    echo
    echo "## Tables"
    echo
    echo "| Table | Source | Target | |"
    echo "|---|---|---|---|"
  } > "$out"

  local tgtval
  while IFS='|' read -r n s _; do
    [ -n "$n" ] || continue
    tgtval="$(awk -F'|' -v k="$n" '$1 == k { print $2; exit }' "$ta")"
    local plain="${n//\"/}"
    if is_excluded "$plain" || is_excluded "${plain#*.}"; then
      echo "| \`$n\` | $s | ${tgtval:--} | data excluded |" >> "$out"
    elif [ -z "$tgtval" ]; then
      echo "| \`$n\` | $s | missing | ❌ |" >> "$out"; fail=$(( fail + 1 ))
    elif [ "$s" = "$tgtval" ]; then
      echo "| \`$n\` | $s | $tgtval | ✅ |" >> "$out"
    else
      echo "| \`$n\` | $s | $tgtval | ❌ |" >> "$out"; fail=$(( fail + 1 ))
    fi
  done < "$sa"
  if [ "$SRC_ENGINE" != mongodb ]; then
    while IFS= read -r t; do
      [ -n "$t" ] && { echo "| \`$t\` | present | missing | ❌ |" >> "$out"; fail=$(( fail + 1 )); }
    done < <(comm -23 <(sort "$STATE/.tables.src") <(sort "$STATE/.tables.tgt"))
  fi

  {
    echo
    echo "## Other objects"
    echo
    echo "| Kind | Source | Target | |"
    echo "|---|---|---|---|"
  } >> "$out"
  if [ "$SRC_ENGINE" = mongodb ]; then
    local si=0 ti=0 x
    while IFS='|' read -r n _ x; do [ -n "$n" ] && ! is_excluded "$n" && si=$(( si + x )); done < "$sa"
    while IFS='|' read -r n _ x; do [ -n "$n" ] && ! is_excluded "$n" && ti=$(( ti + x )); done < "$ta"
    if [ "$si" = "$ti" ]; then echo "| indexes | $si | $ti | ✅ |" >> "$out"; else echo "| indexes | $si | $ti | ❌ |" >> "$out"; fail=$(( fail + 1 )); fi
  else
    local so to
    so="$(objects src)"; to="$(objects tgt)"
    while IFS='|' read -r n s; do
      [ -n "$n" ] || continue
      d="$(awk -F'|' -v k="$n" '$1 == k { print $2 }' <<<"$to")"
      if [ "$s" = "$d" ]; then echo "| $n | $s | $d | ✅ |" >> "$out"
      else echo "| $n | $s | $d | ❌ |" >> "$out"; fail=$(( fail + 1 )); fi
    done <<<"$so"
  fi
  rm -f "$sa" "$ta" "$STATE"/.tables.* "$STATE/.cols"

  echo >> "$out"
  if [ "$fail" -eq 0 ]; then
    echo "**Result: PASS**" >> "$out"
    record_run "$(cat "$STATE/phase" 2>/dev/null || echo test)" validate 0 0 ok
    ok "validation passed — $out"
    return 0
  fi
  echo "**Result: FAIL — $fail difference(s)**" >> "$out"
  record_run "$(cat "$STATE/phase" 2>/dev/null || echo test)" validate 0 0 "fail:$fail"
  warn "validation FAILED: $fail difference(s) — $out"
  grep '❌' "$out" | head -20 >&2
  return 1
}

# ── run (test / rehearsal) ──────────────────────────────────────────────────

cmd_run() {
  require_supported_pair
  load_assessment; load_plan
  local phase="${OPT_PHASE:-test}" t0
  [ "$phase" != cutover ] || die "use '$PROG cutover' for production"
  t0="$(now)"
  log "end-to-end $phase migration — strategy $STRATEGY"
  OPT_PHASE="$phase" cmd_full_load
  if [ "$STRATEGY" = "full-load+cdc" ]; then
    cmd_cdc start
    log "waiting for CDC to catch up (timeout ${OPT_TIMEOUT:-120} min)"
    cdc_wait "${OPT_TIMEOUT:-120}"
  fi
  local vr=0
  cmd_validate || vr=$?
  if [ "$STRATEGY" = "full-load+cdc" ] && [ "${OPT_KEEP_CDC:-0}" != 1 ]; then cdc_stop; fi
  local secs=$(( $(now) - t0 ))
  record_run "$phase" "end-to-end" "$secs" "${SIZE_BYTES:-0}" "$( [ "$vr" = 0 ] && echo ok || echo fail )"
  echo
  ok "$phase migration took $(( secs / 60 ))m$(( secs % 60 ))s end to end"
  info "next: re-plan with the measured numbers →  $PROG plan $CONF"
  info "report of all runs →  $PROG report $CONF"
  return "$vr"
}

# ── cutover ─────────────────────────────────────────────────────────────────

cmd_cutover() {
  require_supported_pair
  load_assessment; load_plan
  echo cutover > "$STATE/phase"
  local blockers
  blockers="$(grep -c . "$STATE/blockers.txt" || true)"
  [ "$blockers" = 0 ] || [ "${OPT_FORCE:-0}" = 1 ] || die "the assessment still lists $blockers blocker(s). Fix them and re-run assess (or --force if they are accepted)."
  grep -q '|rehearsal|end-to-end|.*|ok$' "$STATE/runs.log" 2>/dev/null \
    || warn "no successful rehearsal is recorded for this migration"

  confirm "$MIGRATION_NAME" "PRODUCTION CUTOVER: $SRC_HOST/$SRC_DB → $TGT_HOST/$TGT_DB, strategy $STRATEGY.
Application writes to the source must be STOPPED before continuing."
  local t0; t0="$(now)"

  if [ "$STRATEGY" = full-load ]; then
    OPT_PHASE=cutover cmd_full_load
  else
    log "waiting for CDC to drain (timeout $CUTOVER_WAIT_MINUTES min)"
    cdc_wait "$CUTOVER_WAIT_MINUTES"
    if [ "$SRC_ENGINE" = postgres ]; then
      log "copying sequence values (logical replication does not carry them)"
      local sql
      sql="$(q src "SELECT coalesce(string_agg(format('SELECT setval(%L, %s, %s);', format('%I.%I', schemaname, sequencename), coalesce(last_value, start_value), CASE WHEN last_value IS NULL THEN 'false' ELSE 'true' END), ' '), '') FROM pg_sequences WHERE schemaname IN ($(pg_schema_list))")"
      [ -z "$sql" ] || { q tgt "$sql" >/dev/null; ok "sequences copied"; }
    fi
  fi

  # With CDC, a validation can fail only because the last changes are still in
  # flight; give it a few chances before calling it a real difference.
  local tries=1
  [ "$STRATEGY" = full-load ] || tries=5
  until cmd_validate; do
    tries=$(( tries - 1 ))
    [ "$tries" -gt 0 ] || die "validation failed — DO NOT switch the applications. CDC is still running; investigate $STATE/validation.md."
    info "re-checking in 20s (changes may still be in flight)"; sleep 20
  done

  [ "$STRATEGY" = full-load ] || cdc_stop
  record_run cutover end-to-end $(( $(now) - t0 )) "${SIZE_BYTES:-0}" ok
  cat >&2 <<EOF

  ✅ Data is on the target and validated ($(( ($(now) - t0) / 60 )) min). Now, in this order:

     1. Create users / roles / grants on the target (not migrated): ${ROLES:-see assessment.md}
     2. Point the applications at $TGT_HOST:$TGT_PORT/$TGT_DB and re-enable writes.
     3. Smoke-test the application.
     4. Keep the source read-only and untouched until the fallback window ends.
EOF
}

# ── report / init / help ────────────────────────────────────────────────────

cmd_report() {
  [ -f "$STATE/runs.log" ] || die "no runs recorded yet"
  printf '%-22s %-10s %-18s %10s %12s %s\n' WHEN PHASE STEP SECONDS THROUGHPUT RESULT
  local w p s sec b r
  while IFS='|' read -r w p s sec b r; do
    [ "$s" = full-load-started ] && continue
    local tp="-"
    [ "$sec" -gt 0 ] && [ "$b" -gt 0 ] && tp="$(hb $(( b / sec )))/s"
    printf '%-22s %-10s %-18s %10s %12s %s\n' "$w" "$p" "$s" "$sec" "$tp" "$r"
  done < "$STATE/runs.log"
  echo
  echo "reports: $STATE/{assessment,plan,validation}.md"
}

cmd_init() {
  local name="${1:-}" f
  [ -n "$name" ] || die "usage: $PROG init <name>   (lowercase letters, digits, _)"
  valid name "$name" '^[a-z0-9_]+$'
  f="$PWD/$name.conf"
  [ ! -e "$f" ] || die "$f already exists"
  sed "s/^MIGRATION_NAME=.*/MIGRATION_NAME=$name/" "$HERE/migration.example.conf" > "$f"
  ok "created $f — fill in the endpoints and requirements, then:"
  info "export SRC_PASSWORD=… TGT_PASSWORD=…"
  info "$PROG assess $f"
}

usage() {
  cat <<EOF
$PROG — move a whole database (schema + data) between servers, end to end.
Same engine or different engines (postgres, mariadb, mysql, mongodb in any
direction); different engines are converted by this tool, full load only.

Usage: $PROG <command> <config> [options]

  init <name>              create <name>.conf from the template

  1. assess   <config>     requirements review: versions, encoding, size, LOB
                           columns, tables without keys, log rate, CDC readiness
  2. plan     <config>     choose full-load vs full-load+cdc, estimate, schedule
     run      <config>     end-to-end test: load → (cdc) → validate, timed
                           --phase test|rehearsal  (default test)
  3. plan     <config>     re-plan with the measured throughput
  4. run      <config> --phase rehearsal
  5. cutover  <config>     production: drain CDC, sequences, validate, stop CDC

  Steps on their own:
     full-load <config>    dump the source and load the (empty) target
     cdc start|status|wait|stop <config>
     validate  <config>    compare row counts and objects  (--checksum: content;
                           across engines: per-column sums and text lengths)
     report    <config>    every timed run so far

Options:
  --phase P        test | rehearsal | cutover     --deep      measure LOB lengths (scans)
  --checksum       compare table content          --sample N  seconds to sample log rate
  --strategy S     force full-load | full-load+cdc
  --timeout M      minutes to wait for CDC        --keep-cdc  leave CDC running after run
  --yes            no confirmation prompt         --force     cutover despite blockers

Passwords come from the environment only: SRC_PASSWORD, TGT_PASSWORD
(optional REPL_PASSWORD; MongoDB may use SRC_MONGO_URI / TGT_MONGO_URI instead).
Reports and state: runs/<name>/ next to this script (override with STATE_DIR)
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|-h|--help) usage; return ;;
    init) cmd_init "$@"; return ;;
  esac
  local sub=""
  [ "$cmd" != cdc ] || { sub="${1:-}"; shift || true; }
  local conf="${1:-}"; shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --phase) OPT_PHASE="${2:?}"; valid --phase "$OPT_PHASE" '^(test|rehearsal|cutover)$'; shift 2 ;;
      --strategy) OPT_STRATEGY="${2:?}"; valid --strategy "$OPT_STRATEGY" '^(full-load|full-load\+cdc)$'; shift 2 ;;
      --timeout) OPT_TIMEOUT="${2:?}"; valid --timeout "$OPT_TIMEOUT" '^[0-9]+$'; shift 2 ;;
      --sample) SAMPLE_SECONDS_OPT="${2:?}"; valid --sample "$SAMPLE_SECONDS_OPT" '^[0-9]+$'; shift 2 ;;
      --deep) OPT_DEEP=1; shift ;;
      --checksum) OPT_CHECKSUM=1; shift ;;
      --keep-cdc) OPT_KEEP_CDC=1; shift ;;
      --yes) OPT_YES=1; shift ;;
      --force) OPT_FORCE=1; shift ;;
      *) die "unknown option '$1' ($PROG help)" ;;
    esac
  done
  load_config "$conf"
  [ -z "${SAMPLE_SECONDS_OPT:-}" ] || SAMPLE_SECONDS="$SAMPLE_SECONDS_OPT"
  if [ "$CLIENT_MODE" = docker ]; then
    docker info >/dev/null 2>&1 || die "Docker is installed but not reachable. Start it, or set CLIENT_MODE=local to use local client tools."
  fi
  case "$cmd" in
    assess)    cmd_assess ;;
    plan)      cmd_plan ;;
    full-load) cmd_full_load ;;
    cdc)       cmd_cdc "$sub" ;;
    validate)  cmd_validate ;;
    run)       cmd_run ;;
    cutover)   cmd_cutover ;;
    report)    cmd_report ;;
    *) die "unknown command '$cmd' ($PROG help)" ;;
  esac
}

main "$@"
