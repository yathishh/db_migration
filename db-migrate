#!/usr/bin/env bash
# db-migrate — move a whole database (schema + data) from one server to another.
#
# Follows the five-phase migration workflow:
#
#   1. assess / plan   review the requirements: purpose, targets, scale,
#                      downtime, latency, deadline → a written plan
#   2. run --phase test       a full test migration into a non-production target
#   3. plan (again)           re-plan with the throughput the test MEASURED
#   4. run --phase rehearsal  the same steps, timed, as the real day will run
#   5. cutover                production: stop writes → catch up → verify → switch
#
# Same engine, with each engine's native tools:
#   postgres   pg_dump/pg_restore, logical replication for CDC
#   mariadb    mariadb-dump, binlog replication for CDC
#   mysql      mysqldump,   binlog replication for CDC
#   mongodb    mongodump/mongorestore (full load only — no native CDC)
# Different engines (postgres ⇄ mariadb/mysql, any SQL ⇄ mongodb), with no
# AWS DMS: the schema is converted and the data transformed in flight by
# lib/xengine.sh. Full load only; views/functions/triggers are exported for
# manual conversion.
#
# Runs anywhere that can reach both databases: a laptop, a bastion, a CI runner.
# Client tools come from pinned Docker images, or from the local PATH when
# there is no Docker (CLIENT_MODE=local).
#
# Usage: db-migrate <command> <config> [options]     (db-migrate help)

set -euo pipefail
export LC_ALL=C   # stable sort/comm/join for comparing table lists

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROG="$(basename "$0")"

# Pinned client images. The postgres client must be at least as new as the
# source SERVER (pg_dump refuses to dump a newer server), so it tracks the
# newest major; override per migration if your servers are newer still.
PG_IMAGE="${PG_IMAGE:-postgres:17-alpine}"
MARIADB_IMAGE="${MARIADB_IMAGE:-mariadb:11}"
MYSQL_IMAGE="${MYSQL_IMAGE:-mysql:8.4}"
MONGO_IMAGE="${MONGO_IMAGE:-mongo:7}"
DOCKER_NETWORK="${DOCKER_NETWORK:-host}"

log()  { printf '▶ %s\n' "$*" >&2; }
ok()   { printf '  ✅ %s\n' "$*" >&2; }
info() { printf '  %s\n' "$*" >&2; }
warn() { printf '  ⚠️  %s\n' "$*" >&2; }
die()  { printf '❌ %s\n' "$*" >&2; exit 1; }

hb() { # human-readable bytes
  awk -v b="${1:-0}" 'BEGIN { split("B KB MB GB TB PB", u, " "); i = 1
    while (b >= 1024 && i < 6) { b /= 1024; i++ }
    if (i == 1) printf "%d %s", b, u[i]; else printf "%.1f %s", b, u[i] }'
}
now() { date +%s; }
ceil_div() { echo $(( ($1 + $2 - 1) / $2 )); }

# date_add <YYYY-MM-DD> <days> — GNU date, with a BSD/macOS fallback.
date_add() {
  date -d "$1 $2 day" +%F 2>/dev/null \
    || date -j -v"$( [ "$2" -ge 0 ] && echo "+" )$2"d -f %F "$1" +%F 2>/dev/null \
    || die "cannot do date arithmetic on this system"
}
date_days_between() { # days from $1 to $2
  local a b
  a="$(date -d "$1" +%s 2>/dev/null || date -j -f %F "$1" +%s)"
  b="$(date -d "$2" +%s 2>/dev/null || date -j -f %F "$2" +%s)"
  echo $(( (b - a) / 86400 ))
}

urlenc() {
  local s="$1" out="" c i
  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in [a-zA-Z0-9._~-]) out+="$c" ;; *) out+="$(printf '%%%02X' "'$c")" ;; esac
  done
  printf '%s' "$out"
}

# ── configuration ───────────────────────────────────────────────────────────

valid() { # valid <name> <value> <regex>
  [[ "$2" =~ $3 ]] || die "$1='$2' contains characters this tool does not accept (allowed: $3)"
}

load_config() {
  CONF="${1:-}"
  [ -n "$CONF" ] || die "no config file given. Create one with: $PROG init <name>"
  [ -f "$CONF" ] || die "config file '$CONF' not found"
  # shellcheck source=/dev/null
  . "$CONF"

  : "${MIGRATION_NAME:?MIGRATION_NAME is required in $CONF}"
  : "${SRC_ENGINE:?SRC_ENGINE is required in $CONF}"
  : "${SRC_HOST:?SRC_HOST is required}" "${SRC_USER:?SRC_USER is required}" "${SRC_DB:?SRC_DB is required}"
  : "${TGT_HOST:?TGT_HOST is required}" "${TGT_USER:?TGT_USER is required}"
  TGT_ENGINE="${TGT_ENGINE:-$SRC_ENGINE}"
  TGT_DB="${TGT_DB:-$SRC_DB}"
  PURPOSE="${PURPOSE:-migration}"
  SCHEMAS="${SCHEMAS:-public}"
  EXCLUDE_DATA_TABLES="${EXCLUDE_DATA_TABLES:-}"
  DOWNTIME_MINUTES="${DOWNTIME_MINUTES:-60}"
  MAX_LAG_SECONDS="${MAX_LAG_SECONDS:-60}"
  CDC_MAX_LAG_BYTES="${CDC_MAX_LAG_BYTES:-16777216}"
  DEADLINE="${DEADLINE:-}"
  THROUGHPUT_MBPS="${THROUGHPUT_MBPS:-20}"
  MARGIN_PCT="${MARGIN_PCT:-50}"
  VALIDATE_MINUTES="${VALIDATE_MINUTES:-15}"
  SWITCH_MINUTES="${SWITCH_MINUTES:-15}"
  JOBS="${JOBS:-1}"
  TGT_MANAGED="${TGT_MANAGED:-none}"
  STRIP_DEFINERS="${STRIP_DEFINERS:-true}"
  PG_KEEP_OWNERSHIP="${PG_KEEP_OWNERSHIP:-false}"
  SAMPLE_SECONDS="${SAMPLE_SECONDS:-60}"
  CUTOVER_WAIT_MINUTES="${CUTOVER_WAIT_MINUTES:-30}"

  local e
  for e in "$SRC_ENGINE" "$TGT_ENGINE"; do
    case "$e" in postgres|mariadb|mysql|mongodb) ;; *) die "unknown engine '$e' (postgres|mariadb|mysql|mongodb)";; esac
  done
  for e in SRC TGT; do
    local v="${e}_ENGINE" p="${e}_PORT"
    if [ -z "${!p:-}" ]; then
      case "${!v}" in postgres) printf -v "$p" 5432;; mariadb|mysql) printf -v "$p" 3306;; mongodb) printf -v "$p" 27017;; esac
    fi
  done
  REPL_HOST="${REPL_HOST:-$SRC_HOST}"; REPL_PORT="${REPL_PORT:-$SRC_PORT}"
  REPL_USER="${REPL_USER:-$SRC_USER}"
  load_transport_security

  valid MIGRATION_NAME "$MIGRATION_NAME" '^[a-z0-9_]+$'
  valid PURPOSE "$PURPOSE" '^(migration|replication)$'
  valid TGT_MANAGED "$TGT_MANAGED" '^(none|rds)$'
  for e in SRC_HOST TGT_HOST REPL_HOST; do valid "$e" "${!e}" '^[A-Za-z0-9._:-]+$'; done
  for e in SRC_USER TGT_USER REPL_USER SRC_DB TGT_DB; do valid "$e" "${!e}" '^[A-Za-z0-9_.$-]+$'; done
  for e in SRC_PORT TGT_PORT REPL_PORT DOWNTIME_MINUTES MAX_LAG_SECONDS THROUGHPUT_MBPS MARGIN_PCT JOBS SAMPLE_SECONDS; do
    valid "$e" "${!e}" '^[0-9]+$'
  done
  for e in $SCHEMAS; do valid SCHEMAS "$e" '^[A-Za-z0-9_]+$'; done
  for e in $EXCLUDE_DATA_TABLES; do valid EXCLUDE_DATA_TABLES "$e" '^[A-Za-z0-9_.$-]+$'; done
  [ -z "$DEADLINE" ] || valid DEADLINE "$DEADLINE" '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
  [ "$JOBS" -ge 1 ] || JOBS=1

  STATE="${STATE_DIR:-$HERE/runs/$MIGRATION_NAME}"
  mkdir -p "$STATE"
  PUB="dbm_${MIGRATION_NAME}"

  if [ -z "${CLIENT_MODE:-}" ] || [ "$CLIENT_MODE" = auto ]; then
    if command -v docker >/dev/null 2>&1; then CLIENT_MODE=docker; else CLIENT_MODE=local; fi
  fi
}

# ── encryption in transit ───────────────────────────────────────────────────
#
# Every connection is TLS-encrypted by default, and nothing silently falls
# back to plain text:
#
#   require  (default) encrypted; refuses to run if the server cannot do TLS
#   verify   encrypted AND the server's certificate is checked against
#            <SIDE>_SSL_CA (hostname included) — stops man-in-the-middle too
#   disable  plain text — only with ALLOW_INSECURE_TRANSPORT=yes
#
# "prefer" is deliberately not accepted: it quietly downgrades to plain text
# when the server does not offer TLS, which is exactly the failure to prevent.
# The same applies to the CDC connection the TARGET server opens to the
# source (REPL_SSL, REPL_SSL_CA_PATH).
load_transport_security() {
  local side var mode ca
  for side in SRC TGT; do
    var="${side}_SSL"; mode="${!var:-require}"; printf -v "$var" '%s' "$mode"
    case "$mode" in
      require|verify) ;;
      prefer) die "$var=prefer can silently fall back to plain text. Use require (the default) or verify." ;;
      disable)
        [ "${ALLOW_INSECURE_TRANSPORT:-no}" = yes ] \
          || die "$var=disable sends data and passwords in plain text. Refused unless ALLOW_INSECURE_TRANSPORT=yes is set explicitly." ;;
      *) die "$var must be require, verify or disable (got '$mode')" ;;
    esac
    var="${side}_SSL_CA"; ca="${!var:-}"
    printf -v "${side}_SSL_CA_PEM" '%s' ""
    if [ "$mode" = verify ]; then
      [ -n "$ca" ] || die "${side}_SSL=verify needs ${side}_SSL_CA=/path/to/ca.pem (e.g. the AWS RDS global bundle, or your system bundle /etc/ssl/certs/ca-certificates.crt for public CAs)"
      [ -r "$ca" ] || die "${side}_SSL_CA: cannot read '$ca'"
      grep -q -- '-----BEGIN CERTIFICATE-----' "$ca" || die "${side}_SSL_CA: '$ca' is not a PEM certificate bundle"
      printf -v "${side}_SSL_CA_PEM" '%s' "$(cat "$ca")"
    fi
  done
  REPL_SSL="${REPL_SSL:-require}"
  case "$REPL_SSL" in
    require) ;;
    verify) [ -n "${REPL_SSL_CA_PATH:-}" ] || die "REPL_SSL=verify needs REPL_SSL_CA_PATH — the CA file's path ON THE TARGET SERVER" ;;
    disable) [ "${ALLOW_INSECURE_TRANSPORT:-no}" = yes ] || die "REPL_SSL=disable is refused unless ALLOW_INSECURE_TRANSPORT=yes" ;;
    *) die "REPL_SSL must be require, verify or disable" ;;
  esac
  [ -z "${REPL_SSL_CA_PATH:-}" ] || valid REPL_SSL_CA_PATH "$REPL_SSL_CA_PATH" '^[A-Za-z0-9_./-]+$'
  # The data stream runs through the Docker API. A remote daemon over plain
  # TCP would carry every row unencrypted across the network.
  if [[ "${DOCKER_HOST:-}" == tcp://* ]] && [ "${DOCKER_TLS_VERIFY:-}" != 1 ] && [ "${ALLOW_INSECURE_TRANSPORT:-no}" != yes ]; then
    die "DOCKER_HOST=$DOCKER_HOST without DOCKER_TLS_VERIFY=1 would stream the data unencrypted to the Docker daemon. Use TLS (or ssh://), or CLIENT_MODE=local."
  fi
}

# Only the same engine uses its own dump tools. MariaDB ⇄ MySQL looks close
# enough for a raw dump, but each has collations, types and syntax the other
# rejects (utf8mb4_uca1400_ai_ci, utf8mb4_0900_ai_ci, UUID, sequences), so it
# goes through the converter with exact type passthrough instead.
same_family() { [ "$SRC_ENGINE" = "$TGT_ENGINE" ]; }
homogeneous() { [ "$SRC_ENGINE" = "$TGT_ENGINE" ]; }

# Every engine pair is supported: same engine / same family by native dump
# tools (this file), different engines by schema conversion (lib/xengine.sh).
require_supported_pair() { :; }

# shellcheck source=lib/xengine.sh
. "$HERE/lib/xengine.sh"

# ── running clients ─────────────────────────────────────────────────────────
#
# Every connection detail and every SQL statement reaches the client through
# the ENVIRONMENT and is expanded inside the client's shell, never spliced into
# a command line: no quoting bugs, no injection, and no password in `ps`.

CLIENT_ENVS=(PGPASSWORD PGSSLMODE MYSQL_PWD MONGO_URI MONGO_JS MONGO_CFG_YAML
             DBM_SQL DBM_H DBM_P DBM_U DBM_D DBM_TLS DBM_SRCDB DBM_CA
             DBM_H2 DBM_P2 DBM_U2 DBM_D2 DBM_PW2 DBM_TLS2 DBM_CA2)

# Runs first in every client shell. The CA bundle arrives as text in DBM_CA
# (no bind mount needed, so it works with any Docker daemon) and is written to
# a private temp file; "@CA@" in the TLS options and the MongoDB URI is then
# replaced by that file's path. DBM_CA2 is the target's, for the one command
# that talks to both sides (parallel pg_dump → pg_restore).
TLS_PREFIX='umask 077; DBM_CAF=; DBM_CAF2=;
if [ -n "${DBM_CA:-}" ]; then
  DBM_CAF=$(mktemp); printf "%s\n" "$DBM_CA" > "$DBM_CAF"; export PGSSLROOTCERT="$DBM_CAF"
  DBM_TLS=$(printf "%s" "$DBM_TLS" | sed "s#@CA@#$DBM_CAF#g")
  MONGO_URI=$(printf "%s" "${MONGO_URI:-}" | sed "s#@CA@#$DBM_CAF#g")
  MONGO_CFG_YAML=$(printf "%s" "${MONGO_CFG_YAML:-}" | sed "s#@CA@#$DBM_CAF#g")
  export DBM_TLS MONGO_URI MONGO_CFG_YAML
fi
if [ -n "${DBM_CA2:-}" ]; then DBM_CAF2=$(mktemp); printf "%s\n" "$DBM_CA2" > "$DBM_CAF2"; fi
trap "rm -f \"\$DBM_CAF\" \"\$DBM_CAF2\"" EXIT
'

engine_image() {
  case "$1" in postgres) echo "$PG_IMAGE";; mariadb) echo "$MARIADB_IMAGE";; mysql) echo "$MYSQL_IMAGE";; mongodb) echo "$MONGO_IMAGE";; esac
}

# client <engine> <shell command>
client() {
  local engine="$1"; shift
  if [ "$CLIENT_MODE" = local ]; then
    sh -c "$TLS_PREFIX$*"
  else
    local -a envs=(); local v
    for v in "${CLIENT_ENVS[@]}"; do envs+=(-e "$v"); done
    # -i and never -t: a TTY would rewrite the binary dump stream.
    docker run --rm -i --network "$DOCKER_NETWORK" --user "$(id -u):$(id -g)" \
      "${envs[@]}" -e HOME=/tmp --entrypoint sh "$(engine_image "$engine")" -c "$TLS_PREFIX$*"
  fi
}

# use <src|tgt> — point the client environment at one side.
use() {
  local p
  case "$1" in src) p=SRC;; tgt) p=TGT;; *) die "internal: bad side '$1'";; esac
  local v pw ssl
  v="${p}_ENGINE"; C_ENGINE="${!v}"
  v="${p}_HOST";   C_HOST="${!v}"
  v="${p}_PORT";   C_PORT="${!v}"
  v="${p}_USER";   C_USER="${!v}"
  v="${p}_DB";     C_DB="${!v}"
  v="${p}_SSL";    ssl="${!v}"
  v="${p}_SSL_CA_PEM"; export DBM_CA="${!v}"
  v="${p}_PASSWORD"; pw="${!v:-}"
  local uri_var="${p}_MONGO_URI"
  if [ -z "$pw" ] && ! { [ "$C_ENGINE" = mongodb ] && [ -n "${!uri_var:-}" ]; }; then
    die "${p}_PASSWORD is not set — export it in your shell (it is never read from the config file's directory or written anywhere)"
  fi
  export DBM_H="$C_HOST" DBM_P="$C_PORT" DBM_U="$C_USER" DBM_D="$C_DB" DBM_SRCDB="$SRC_DB"
  DBM_TLS=""
  case "$C_ENGINE" in
    postgres)
      case "$ssl" in verify) ssl=verify-full;; esac
      export PGPASSWORD="$pw" PGSSLMODE="$ssl" ;;
    mariadb)
      export MYSQL_PWD="$pw"
      case "$ssl" in
        require) DBM_TLS="--ssl --ssl-verify-server-cert=0" ;;
        verify)  DBM_TLS="--ssl --ssl-ca=@CA@ --ssl-verify-server-cert" ;;
        disable) DBM_TLS="--skip-ssl" ;;
      esac ;;
    mysql)
      export MYSQL_PWD="$pw"
      case "$ssl" in
        require) DBM_TLS="--ssl-mode=REQUIRED" ;;
        verify)  DBM_TLS="--ssl-mode=VERIFY_IDENTITY --ssl-ca=@CA@" ;;
        # caching_sha2_password refuses a plain-text login unless the client
        # may fetch the server's RSA key to protect the password.
        disable) DBM_TLS="--ssl-mode=DISABLED --get-server-public-key" ;;
      esac ;;
    mongodb)
      if [ -n "${!uri_var:-}" ]; then
        MONGO_URI="${!uri_var}"
        if [ "$ssl" != disable ] && [[ "$MONGO_URI" != mongodb+srv://* ]] && ! [[ "$MONGO_URI" =~ [?\&](tls|ssl)=true ]]; then
          die "${uri_var} does not enable TLS. Add tls=true to it (or use mongodb+srv://, which implies TLS)."
        fi
      else
        local adb_var="${p}_AUTH_DB"
        MONGO_URI="mongodb://$(urlenc "$C_USER"):$(urlenc "$pw")@${C_HOST}:${C_PORT}/?authSource=${!adb_var:-admin}"
        case "$ssl" in
          require) MONGO_URI+="&tls=true&tlsAllowInvalidCertificates=true" ;;
          verify)  MONGO_URI+="&tls=true&tlsCAFile=@CA@" ;;
        esac
      fi
      export MONGO_URI
      MONGO_CFG_YAML="uri: '$(printf '%s' "$MONGO_URI" | sed "s/'/''/g")'"; export MONGO_CFG_YAML ;;
  esac
  export DBM_TLS
}

# mongo tools read the URI from a private temp file, never from argv.
MCFG='umask 077; c=$(mktemp); trap "rm -f \"$c\" \"$DBM_CAF\" \"$DBM_CAF2\"" EXIT; printf "%s\n" "$MONGO_CFG_YAML" > "$c";'

# q <side> <sql> — rows on stdout, columns separated by '|'.
# Set QDB= (empty) to connect a MariaDB/MySQL client without a default database.
# stdin is /dev/null: `docker run -i` would otherwise swallow the input of any
# `while read` loop that calls q() — silently ending the loop after one pass.
q() {
  use "$1"; export DBM_SQL="$2"
  [ -z "${QDB+x}" ] || export DBM_D="$QDB"
  case "$C_ENGINE" in
    postgres) client postgres 'psql -X -A -t -q -v ON_ERROR_STOP=1 -F "|" -h "$DBM_H" -p "$DBM_P" -U "$DBM_U" -d "$DBM_D" -c "$DBM_SQL"' < /dev/null ;;
    mariadb)  client mariadb  'mariadb $DBM_TLS -h "$DBM_H" -P "$DBM_P" -u "$DBM_U" -N -B ${DBM_D:+"$DBM_D"} -e "$DBM_SQL"' < /dev/null | tr '\t' '|' ;;
    mysql)    client mysql    'mysql $DBM_TLS -h "$DBM_H" -P "$DBM_P" -u "$DBM_U" -N -B ${DBM_D:+"$DBM_D"} -e "$DBM_SQL"' < /dev/null | tr '\t' '|' ;;
    *) die "internal: q() on $C_ENGINE" ;;
  esac
}

# qv <side> <sql> — MariaDB/MySQL vertical output (SHOW ... STATUS)
qv() {
  use "$1"; export DBM_SQL="$2"
  case "$C_ENGINE" in
    mariadb) client mariadb 'mariadb $DBM_TLS -h "$DBM_H" -P "$DBM_P" -u "$DBM_U" -E -e "$DBM_SQL"' < /dev/null ;;
    mysql)   client mysql   'mysql $DBM_TLS -h "$DBM_H" -P "$DBM_P" -u "$DBM_U" -E -e "$DBM_SQL"' < /dev/null ;;
  esac
}

# js <side> <javascript> — run against the side's database as `db`.
js() {
  use "$1"
  MONGO_JS="void (globalThis.db = connect(process.env.MONGO_URI).getSiblingDB(process.env.DBM_D));
$2"
  export MONGO_JS
  client mongodb 'mongosh --nodb --quiet --eval "$MONGO_JS"' < /dev/null
}

pg_schema_list() { local s o=""; for s in $SCHEMAS; do o+="${o:+,}'$s'"; done; printf '%s' "$o"; }
pg_excl_list()   { local s o=""; for s in $EXCLUDE_DATA_TABLES; do o+="${o:+,}'$s'"; done; printf '%s' "${o:-''}"; }
is_excluded()    { local t; for t in $EXCLUDE_DATA_TABLES; do [ "$t" = "$1" ] && return 0; done; return 1; }

ver_major() { # comparable version: "10.11.6-MariaDB" → 1011, "8.4.2" → 804; mongodb "7.0.12" → 7
  if [ "${2:-}" = mongodb ]; then awk -F'[.-]' '{ print $1 + 0 }' <<<"$1"
  else awk -F'[.-]' '{ printf "%d%02d\n", $1, $2 }' <<<"$1"; fi
}

record_run() { # record_run <phase> <step> <seconds> <bytes> <status>
  printf '%s|%s|%s|%s|%s|%s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" "$4" "$5" >> "$STATE/runs.log"
}

load_assessment() {
  [ -f "$STATE/assessment.env" ] || die "no assessment yet — run: $PROG assess $CONF"
  # shellcheck source=/dev/null
  . "$STATE/assessment.env"
}
load_plan() {
  [ -f "$STATE/plan.env" ] || die "no plan yet — run: $PROG plan $CONF"
  # shellcheck source=/dev/null
  . "$STATE/plan.env"
  [ -z "${OPT_STRATEGY:-}" ] || STRATEGY="$OPT_STRATEGY"
}

confirm() { # confirm <what to type> <prompt>
  [ "${OPT_YES:-0}" = 1 ] && return 0
  [ -t 0 ] || die "this step needs confirmation; re-run in a terminal or pass --yes"
  local a
  printf '\n%s\nType %s to continue: ' "$2" "$1" >&2
  read -r a
  [ "$a" = "$1" ] || die "not confirmed — nothing was changed"
}

# ── 1. assess ───────────────────────────────────────────────────────────────

BLOCKERS=(); WARNINGS=(); NOTES=(); CDC_ISSUES=()
declare -A A=()

assess_postgres() {
  local sl row num ver enc coll dbsize
  sl="$(pg_schema_list)"

  log "source: version, encoding, size"
  row="$(q src "SELECT current_setting('server_version_num'), current_setting('server_version'), pg_encoding_to_char(d.encoding), d.datcollate, pg_database_size(current_database()) FROM pg_database d WHERE d.datname = current_database()")" \
    || die "cannot connect to the SOURCE ($SRC_HOST:$SRC_PORT/$SRC_DB) — check network reachability, credentials and SRC_SSL"
  IFS='|' read -r num ver enc coll dbsize <<<"$row"
  A[SRC_VERSION]="$ver"; A[SRC_MAJOR]=$(( num / 10000 )); A[SRC_ENCODING]="$enc"; A[SRC_COLLATION]="$coll"; A[DB_BYTES]="$dbsize"
  ok "PostgreSQL $ver, $enc / $coll, database $(hb "$dbsize")"

  log "source: tables, rows, size in schemas: $SCHEMAS"
  row="$(q src "SELECT count(*), coalesce(sum(greatest(c.reltuples, (SELECT s.n_live_tup FROM pg_stat_all_tables s WHERE s.relid = c.oid), 0)), 0)::bigint, coalesce(sum(pg_total_relation_size(c.oid)), 0) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = 'r' AND n.nspname IN ($sl)")"
  IFS='|' read -r A[TABLES] A[ROWS] A[SIZE_BYTES] <<<"$row"
  ok "${A[TABLES]} tables, ~${A[ROWS]} rows, $(hb "${A[SIZE_BYTES]}") incl. indexes"
  [ "${A[TABLES]}" -gt 0 ] || BLOCKERS+=("No tables found in schemas '$SCHEMAS' of $SRC_DB — check SCHEMAS in the config.")

  q src "SELECT format('%I.%I', n.nspname, c.relname), pg_total_relation_size(c.oid), greatest(c.reltuples, (SELECT s.n_live_tup FROM pg_stat_all_tables s WHERE s.relid = c.oid), 0)::bigint FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = 'r' AND n.nspname IN ($sl) ORDER BY 2 DESC LIMIT 10" > "$STATE/top_tables.txt"

  q src "SELECT format('%I.%I', n.nspname, c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = 'r' AND n.nspname IN ($sl) AND (c.relreplident = 'n' OR (c.relreplident = 'd' AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.conrelid = c.oid AND k.contype = 'p'))) ORDER BY 1" > "$STATE/no_pk.txt"
  A[NO_PK]="$(grep -c . "$STATE/no_pk.txt" || true)"

  log "source: LOB columns (text, bytea, json, jsonb, xml)"
  q src "SELECT format('%I.%I.%I', c.table_schema, c.table_name, c.column_name), c.data_type FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name AND t.table_type = 'BASE TABLE' WHERE c.table_schema IN ($sl) AND c.data_type IN ('text', 'bytea', 'json', 'jsonb', 'xml') ORDER BY 1" > "$STATE/lob_columns.txt"
  A[LOB_COLUMNS]="$(grep -c . "$STATE/lob_columns.txt" || true)"
  if [ "${OPT_DEEP:-0}" = 1 ] && [ "${A[LOB_COLUMNS]}" -gt 0 ]; then
    info "--deep: measuring the longest value of each LOB column (full scans)"
    local sql
    sql="$(q src "SELECT string_agg(format('SELECT %L, coalesce(max(octet_length(%I::text)), 0) FROM %I.%I', format('%I.%I.%I', c.table_schema, c.table_name, c.column_name), c.column_name, c.table_schema, c.table_name), ' UNION ALL ') FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name AND t.table_type = 'BASE TABLE' WHERE c.table_schema IN ($sl) AND c.data_type IN ('text', 'json', 'jsonb', 'xml')")"
    [ -z "$sql" ] || q src "$sql" > "$STATE/lob_max.txt"
    q src "SELECT string_agg(format('SELECT %L, coalesce(max(octet_length(%I)), 0) FROM %I.%I', format('%I.%I.%I', c.table_schema, c.table_name, c.column_name), c.column_name, c.table_schema, c.table_name), ' UNION ALL ') FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name AND t.table_type = 'BASE TABLE' WHERE c.table_schema IN ($sl) AND c.data_type = 'bytea'" > "$STATE/.bytea.sql"
    [ ! -s "$STATE/.bytea.sql" ] || q src "$(cat "$STATE/.bytea.sql")" >> "$STATE/lob_max.txt"
    rm -f "$STATE/.bytea.sql"
    A[LOB_MAX_BYTES]="$(awk -F'|' 'BEGIN{m=0} $2>m{m=$2} END{print m}' "$STATE/lob_max.txt")"
  fi

  row="$(q src "SELECT count(*) FROM pg_largeobject_metadata")"; A[LARGE_OBJECTS]="$row"

  log "source: other objects, extensions, roles"
  row="$(q src "SELECT (SELECT count(*) FROM pg_views WHERE schemaname IN ($sl)), (SELECT count(*) FROM pg_matviews WHERE schemaname IN ($sl)), (SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE n.nspname IN ($sl)), (SELECT count(*) FROM pg_sequences WHERE schemaname IN ($sl)), (SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid JOIN pg_namespace n ON n.oid = c.relnamespace WHERE NOT t.tgisinternal AND n.nspname IN ($sl)), (SELECT coalesce(string_agg(extname, ' ' ORDER BY extname), '') FROM pg_extension WHERE extname <> 'plpgsql')")"
  IFS='|' read -r A[VIEWS] A[MATVIEWS] A[FUNCTIONS] A[SEQUENCES] A[TRIGGERS] A[EXTENSIONS] <<<"$row"
  A[ROLES]="$(q src "SELECT coalesce(string_agg(DISTINCT r, ', '), '') FROM (SELECT grantee::text r FROM information_schema.role_table_grants WHERE table_schema IN ($sl) AND grantee NOT IN ('PUBLIC') UNION SELECT pg_get_userbyid(c.relowner)::text FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname IN ($sl)) x")"

  log "source: CDC readiness (logical replication)"
  local wal slots senders used repl recov
  row="$(q src "SELECT current_setting('wal_level'), current_setting('max_replication_slots'), current_setting('max_wal_senders'), (SELECT count(*) FROM pg_replication_slots), coalesce((SELECT rolsuper OR rolreplication FROM pg_roles WHERE rolname = current_user), false) OR coalesce(pg_has_role(current_user, (SELECT oid FROM pg_roles WHERE rolname = 'rds_replication'), 'member'), false), pg_is_in_recovery()")"
  IFS='|' read -r wal slots senders used repl recov <<<"$row"
  A[WAL_LEVEL]="$wal"
  [ "$wal" = logical ] || CDC_ISSUES+=("wal_level is '$wal'; CDC needs 'logical' (RDS/Aurora: set rds.logical_replication=1 in the parameter group and reboot).")
  [ "$repl" = t ] || CDC_ISSUES+=("$SRC_USER (or REPL_USER) needs REPLICATION (RDS: GRANT rds_replication TO $REPL_USER).")
  [ "$used" -lt "$slots" ] || CDC_ISSUES+=("All $slots replication slots are in use (max_replication_slots).")
  [ "$recov" = f ] || CDC_ISSUES+=("The source is a standby; logical replication from a standby needs PostgreSQL 16+ and hot_standby_feedback.")
  [ "${A[NO_PK]}" -eq 0 ] || CDC_ISSUES+=("${A[NO_PK]} table(s) have no primary key / replica identity (see no_pk.txt). Once published, UPDATE and DELETE on them FAIL ON THE SOURCE. Fix first: ALTER TABLE … REPLICA IDENTITY FULL (or add a primary key).")
  [ "${A[LARGE_OBJECTS]}" -eq 0 ] || CDC_ISSUES+=("${A[LARGE_OBJECTS]} large objects (pg_largeobject) exist; logical replication does not carry them — they are copied only by a full load.")
  NOTES+=("Logical replication does not carry DDL: freeze schema changes on the source from the start of CDC until cutover.")
  [ "${A[SEQUENCES]}" -eq 0 ] || NOTES+=("${A[SEQUENCES]} sequences: logical replication does not advance them; \`cutover\` copies their values before the switch.")

  if [ "$recov" = f ] && [ "$SAMPLE_SECONDS" -gt 0 ]; then
    log "source: measuring WAL generation for ${SAMPLE_SECONDS}s (set SAMPLE_SECONDS=0 or --sample 0 to skip)"
    local l1 l2 d
    l1="$(q src "SELECT pg_current_wal_lsn()")"; sleep "$SAMPLE_SECONDS"; l2="$(q src "SELECT pg_current_wal_lsn()")"
    d="$(q src "SELECT pg_wal_lsn_diff('$l2', '$l1')::bigint")"
    A[LOG_BYTES_PER_HOUR]=$(( d * 3600 / SAMPLE_SECONDS ))
    ok "WAL: $(hb "$d") in ${SAMPLE_SECONDS}s ≈ $(hb "${A[LOG_BYTES_PER_HOUR]}")/hour (whole cluster, this moment only)"
  fi

  if is_xengine; then x_assess_target; return; fi
  log "target: connectivity, version, encoding, emptiness"
  if row="$(q tgt "SELECT current_setting('server_version_num'), current_setting('server_version'), pg_encoding_to_char(d.encoding), d.datcollate FROM pg_database d WHERE d.datname = current_database()")"; then
    local tnum tver tenc tcoll
    IFS='|' read -r tnum tver tenc tcoll <<<"$row"
    A[TGT_VERSION]="$tver"; A[TGT_MAJOR]=$(( tnum / 10000 )); A[TGT_ENCODING]="$tenc"; A[TGT_COLLATION]="$tcoll"
    ok "PostgreSQL $tver, $tenc / $tcoll"
    A[TGT_OBJECTS]="$(q tgt "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r','p','v','m','S','f') AND n.nspname IN ($sl)")"
    local ext missing=""
    for ext in ${A[EXTENSIONS]}; do
      [ -n "$(q tgt "SELECT 1 FROM pg_available_extensions WHERE name = '$ext'")" ] || missing+=" $ext"
    done
    [ -z "$missing" ] || BLOCKERS+=("Extensions used on the source are not available on the target:$missing")
    [ "${A[TGT_MAJOR]}" -ge "${A[SRC_MAJOR]}" ] || BLOCKERS+=("Target is PostgreSQL ${A[TGT_MAJOR]}, older than the source (${A[SRC_MAJOR]}). Moving to an older major is not supported.")
    [ "$tcoll" = "$coll" ] || WARNINGS+=("Collation differs (source $coll, target $tcoll): text sort order and unique indexes on text may behave differently. Verify in the test migration.")
  else
    BLOCKERS+=("Cannot connect to the TARGET ($TGT_HOST:$TGT_PORT/$TGT_DB). Check the network path (VPN / Direct Connect / security groups), credentials and TGT_SSL.")
  fi
}

assess_mysqlish() {
  local row
  log "source: version, character set, binlog"
  row="$(q src "SELECT VERSION(), @@character_set_database, @@collation_database, @@log_bin, @@binlog_format, @@server_id")" \
    || die "cannot connect to the SOURCE ($SRC_HOST:$SRC_PORT/$SRC_DB) — check network reachability, credentials and SRC_SSL"
  local ver cs coll logbin fmt sid
  IFS='|' read -r ver cs coll logbin fmt sid <<<"$row"
  A[SRC_VERSION]="$ver"; A[SRC_MAJOR]="$(ver_major "$ver")"; A[SRC_ENCODING]="$cs"; A[SRC_COLLATION]="$coll"; A[SRC_SERVER_ID]="$sid"
  ok "$ver, $cs / $coll, binlog=$logbin format=$fmt"

  log "source: tables, rows, size"
  row="$(q src "SELECT count(*), coalesce(sum(table_rows), 0), coalesce(sum(data_length + index_length), 0) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE'")"
  IFS='|' read -r A[TABLES] A[ROWS] A[SIZE_BYTES] <<<"$row"
  A[DB_BYTES]="${A[SIZE_BYTES]}"
  ok "${A[TABLES]} tables, ~${A[ROWS]} rows, $(hb "${A[SIZE_BYTES]}") incl. indexes"
  [ "${A[TABLES]}" -gt 0 ] || BLOCKERS+=("No tables found in $SRC_DB.")

  q src "SELECT table_name, data_length + index_length, table_rows FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE' ORDER BY 2 DESC LIMIT 10" > "$STATE/top_tables.txt"
  q src "SELECT t.table_name FROM information_schema.tables t WHERE t.table_schema = DATABASE() AND t.table_type = 'BASE TABLE' AND NOT EXISTS (SELECT 1 FROM information_schema.table_constraints c WHERE c.table_schema = t.table_schema AND c.table_name = t.table_name AND c.constraint_type = 'PRIMARY KEY') ORDER BY 1" > "$STATE/no_pk.txt"
  A[NO_PK]="$(grep -c . "$STATE/no_pk.txt" || true)"
  [ "${A[NO_PK]}" -eq 0 ] || WARNINGS+=("${A[NO_PK]} table(s) without a primary key (no_pk.txt): row-based replication applies each change to them with a full table scan, so CDC lag can grow badly. Validation cannot match rows on them by key either.")

  local nonInno
  nonInno="$(q src "SELECT GROUP_CONCAT(CONCAT(table_name, ' (', engine, ')') SEPARATOR ', ') FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE' AND engine <> 'InnoDB'")"
  [ "$nonInno" = NULL ] || [ -z "$nonInno" ] || WARNINGS+=("Non-InnoDB tables: $nonInno. --single-transaction is not consistent for them; stop writes to them during the full load.")

  log "source: LOB columns (TEXT, BLOB, JSON)"
  q src "SELECT CONCAT(c.table_name, '.', c.column_name), c.data_type FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name AND t.table_type = 'BASE TABLE' WHERE c.table_schema = DATABASE() AND c.data_type IN ('tinytext','text','mediumtext','longtext','tinyblob','blob','mediumblob','longblob','json') ORDER BY 1" > "$STATE/lob_columns.txt"
  A[LOB_COLUMNS]="$(grep -c . "$STATE/lob_columns.txt" || true)"
  if [ "${OPT_DEEP:-0}" = 1 ] && [ "${A[LOB_COLUMNS]}" -gt 0 ]; then
    info "--deep: measuring the longest value of each LOB column (full scans)"
    local sql
    sql="$(q src 'SET SESSION group_concat_max_len = 16777216; SELECT GROUP_CONCAT(CONCAT("SELECT ", QUOTE(CONCAT(c.table_name, ".", c.column_name)), ", COALESCE(MAX(LENGTH(`", REPLACE(c.column_name, "`", "``"), "`)), 0) FROM `", REPLACE(c.table_name, "`", "``"), "`") SEPARATOR " UNION ALL ") FROM information_schema.columns c JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name AND t.table_type = "BASE TABLE" WHERE c.table_schema = DATABASE() AND c.data_type IN ("tinytext","text","mediumtext","longtext","tinyblob","blob","mediumblob","longblob","json")')"
    q src "$sql" > "$STATE/lob_max.txt"
    A[LOB_MAX_BYTES]="$(awk -F'|' 'BEGIN{m=0} $2>m{m=$2} END{print m}' "$STATE/lob_max.txt")"
  fi

  local nonutf
  nonutf="$(q src "SELECT count(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND character_set_name IS NOT NULL AND character_set_name NOT LIKE 'utf8%'")"
  [ "$nonutf" -eq 0 ] || WARNINGS+=("$nonutf column(s) use a non-Unicode character set. Garbled characters are possible — verify sample rows in the test migration.")

  log "source: other objects, definers"
  row="$(q src "SELECT (SELECT count(*) FROM information_schema.views WHERE table_schema = DATABASE()), (SELECT count(*) FROM information_schema.routines WHERE routine_schema = DATABASE()), (SELECT count(*) FROM information_schema.triggers WHERE trigger_schema = DATABASE()), (SELECT count(*) FROM information_schema.events WHERE event_schema = DATABASE())")"
  IFS='|' read -r A[VIEWS] A[FUNCTIONS] A[TRIGGERS] A[EVENTS] <<<"$row"
  A[ROLES]="$(q src "SELECT COALESCE(GROUP_CONCAT(DISTINCT d SEPARATOR ', '), '') FROM (SELECT definer d FROM information_schema.views WHERE table_schema = DATABASE() UNION SELECT definer FROM information_schema.routines WHERE routine_schema = DATABASE() UNION SELECT definer FROM information_schema.triggers WHERE trigger_schema = DATABASE() UNION SELECT definer FROM information_schema.events WHERE event_schema = DATABASE()) x")"
  if [ -n "${A[ROLES]}" ] && [ "$STRIP_DEFINERS" = true ]; then
    NOTES+=("Definers (${A[ROLES]}) are stripped on load (STRIP_DEFINERS=true): views/routines/triggers will be owned by $TGT_USER on the target.")
  fi

  log "source: CDC readiness (binlog replication)"
  [ "$logbin" = 1 ] || CDC_ISSUES+=("Binary logging is off (log_bin=0). Turn it on (RDS: set backup retention > 0).")
  [ "$fmt" = ROW ] || CDC_ISSUES+=("binlog_format is $fmt; set it to ROW.")
  local grants
  grants="$(q src "SHOW GRANTS" 2>/dev/null || true)"
  grep -Eq 'ALL PRIVILEGES ON \*\.\*|REPLICATION (SLAVE|REPLICA)' <<<"$grants" || CDC_ISSUES+=("$REPL_USER needs REPLICATION SLAVE (MySQL: REPLICATION SLAVE; MariaDB 10.5+: REPLICATION REPLICA).")
  grep -Eq 'ALL PRIVILEGES ON \*\.\*|RELOAD' <<<"$grants" || CDC_ISSUES+=("$SRC_USER needs RELOAD to record the binlog position during the dump (FLUSH TABLES WITH READ LOCK, held for a moment).")
  [ "$SRC_DB" = "$TGT_DB" ] || CDC_ISSUES+=("CDC replicates by database name; SRC_DB and TGT_DB must be the same.")
  NOTES+=("The binlog must be retained from the start of the full load until CDC catches up (RDS: CALL mysql.rds_set_configuration('binlog retention hours', 48)).")

  if [ "$logbin" = 1 ] && [ "$SAMPLE_SECONDS" -gt 0 ]; then
    log "source: measuring binlog generation for ${SAMPLE_SECONDS}s"
    local b1 b2
    if b1="$(q src "SHOW BINARY LOGS" 2>/dev/null | awk -F'|' '{s+=$2} END{print s+0}')" && [ "$b1" -gt 0 ]; then
      sleep "$SAMPLE_SECONDS"
      b2="$(q src "SHOW BINARY LOGS" | awk -F'|' '{s+=$2} END{print s+0}')"
      if [ "$b2" -ge "$b1" ]; then
        A[LOG_BYTES_PER_HOUR]=$(( (b2 - b1) * 3600 / SAMPLE_SECONDS ))
        ok "binlog ≈ $(hb "${A[LOG_BYTES_PER_HOUR]}")/hour (whole server, this moment only)"
      else
        warn "binlogs were purged during the sample — rate not measured"
      fi
    else
      warn "SHOW BINARY LOGS not permitted — binlog rate not measured"
    fi
  fi

  if is_xengine; then x_assess_target; return; fi
  log "target: connectivity, version, character set, emptiness"
  if row="$(QDB='' q tgt "SELECT VERSION(), @@character_set_server, @@server_id")"; then
    local tver tcs tsid
    IFS='|' read -r tver tcs tsid <<<"$row"
    A[TGT_VERSION]="$tver"; A[TGT_MAJOR]="$(ver_major "$tver")"; A[TGT_ENCODING]="$tcs"; A[TGT_SERVER_ID]="$tsid"
    ok "$tver, server charset $tcs"
    A[TGT_OBJECTS]="$(QDB='' q tgt "SELECT count(*) FROM information_schema.tables WHERE table_schema = '$TGT_DB'")"
    [ "$tsid" != "$sid" ] || CDC_ISSUES+=("Source and target have the same server_id ($sid); replication needs them different.")
    if homogeneous && [ "${A[TGT_MAJOR]}" -lt "${A[SRC_MAJOR]}" ]; then
      WARNINGS+=("Target ($tver) is older than the source ($ver). Features used on the source may not exist on the target.")
    fi
  else
    BLOCKERS+=("Cannot connect to the TARGET ($TGT_HOST:$TGT_PORT). Check the network path (VPN / Direct Connect / security groups), credentials and TGT_SSL.")
  fi
  if ! homogeneous; then
    WARNINGS+=("$SRC_ENGINE → $TGT_ENGINE: the two have diverged (sequences, JSON storage, system-versioned tables, collations such as utf8mb4_0900_ai_ci). Expect DDL edits; full load only — CDC between them is not supported here.")
    CDC_ISSUES+=("CDC between MariaDB and MySQL is not supported by this tool.")
  fi
}

assess_mongodb() {
  local out
  log "source: version, size, collections, oplog"
  out="$(js src '
    const s = db.stats();
    print("SRC_VERSION=" + db.version());
    print("SIZE_BYTES=" + (Number(s.dataSize) + Number(s.indexSize)));
    print("DB_BYTES=" + Number(s.storageSize));
    print("ROWS=" + Number(s.objects));
    print("INDEXES=" + Number(s.indexes));
    const infos = db.getCollectionInfos();
    const colls = infos.filter(c => c.type === "collection" && !c.name.startsWith("system."));
    print("TABLES=" + colls.length);
    print("VIEWS=" + infos.filter(c => c.type === "view").length);
    print("TIMESERIES=" + infos.filter(c => c.type === "timeseries").length);
    print("CAPPED=" + colls.filter(c => c.options && c.options.capped).length);
    print("VALIDATORS=" + colls.filter(c => c.options && c.options.validator).length);
    const sizes = colls.map(c => { let st = {}; try { st = db.getCollection(c.name).stats(); } catch (e) {}
      return [c.name, Number(st.size || 0) + Number(st.totalIndexSize || 0), Number(st.count || 0)]; });
    sizes.sort((a, b) => b[1] - a[1]).slice(0, 10).forEach(x => print("TOP=" + x.join("|")));
    const h = db.hello();
    print("REPLSET=" + (h.setName || ""));
    try { const r = db.getReplicationInfo();
      if (r && r.timeDiff > 0) {
        print("OPLOG_WINDOW_HOURS=" + Math.floor(r.timeDiff / 3600));
        print("LOG_BYTES_PER_HOUR=" + Math.floor(r.usedMB * 1048576 / (r.timeDiff / 3600)));
      } } catch (e) {}
  ')" || die "cannot connect to the SOURCE ($SRC_HOST:$SRC_PORT/$SRC_DB) — check network, credentials, SRC_AUTH_DB and SRC_SSL"
  local line k
  while IFS= read -r line; do
    case "$line" in
      TOP=*) printf '%s\n' "${line#TOP=}" >> "$STATE/top_tables.txt" ;;
      *=*)   k="${line%%=*}"; A[$k]="${line#*=}" ;;
    esac
  done <<<"$out"
  A[SRC_MAJOR]="$(ver_major "${A[SRC_VERSION]}" mongodb)"; A[SRC_ENCODING]="UTF-8 (BSON)"
  A[NO_PK]=0; A[LOB_COLUMNS]=0
  ok "MongoDB ${A[SRC_VERSION]}, ${A[TABLES]} collections, ${A[ROWS]} documents, $(hb "${A[SIZE_BYTES]}")"
  [ -n "${A[REPLSET]:-}" ] || NOTES+=("Source is not a replica set: there is no oplog, so no CDC of any kind is possible — full load in a write freeze only.")
  [ -z "${A[OPLOG_WINDOW_HOURS]:-}" ] || NOTES+=("Oplog window ≈ ${A[OPLOG_WINDOW_HOURS]}h.")
  CDC_ISSUES+=("This tool has no native MongoDB CDC. For short downtime use mongosync (MongoDB 6.0+ on both sides) or AWS DMS Homogeneous Data Migrations (DocumentDB / MongoDB targets).")
  NOTES+=("Users and roles are not copied (mongodump --db does not include them): create them on the target.")

  if is_xengine; then x_assess_target; return; fi
  log "target: connectivity, version, emptiness"
  if out="$(js tgt 'print(db.version() + "|" + db.getCollectionNames().filter(n => !n.startsWith("system.")).length)')"; then
    IFS='|' read -r A[TGT_VERSION] A[TGT_OBJECTS] <<<"$out"
    A[TGT_MAJOR]="$(ver_major "${A[TGT_VERSION]}" mongodb)"; A[TGT_ENCODING]="UTF-8 (BSON)"
    ok "MongoDB ${A[TGT_VERSION]}"
    [ "${A[TGT_MAJOR]}" -ge "${A[SRC_MAJOR]}" ] || WARNINGS+=("Target ${A[TGT_VERSION]} is older than the source ${A[SRC_VERSION]}; check featureCompatibilityVersion and operators used.")
  else
    BLOCKERS+=("Cannot connect to the TARGET ($TGT_HOST:$TGT_PORT). Check the network path, credentials, TGT_AUTH_DB and TGT_SSL.")
  fi
}

# assess_transport <src|tgt> — ask the SERVER what protects this session, so
# the report shows evidence, not intent. Unencrypted when it should not be
# is a blocker.
assess_transport() {
  local side="$1" P mode got=""
  P="$( [ "$side" = src ] && echo SRC || echo TGT )"; mode="${P}_SSL"; mode="${!mode}"
  case "$( [ "$side" = src ] && echo "$SRC_ENGINE" || echo "$TGT_ENGINE" )" in
    postgres)
      got="$(q "$side" "SELECT coalesce((SELECT version || ' ' || cipher FROM pg_stat_ssl WHERE pid = pg_backend_pid() AND ssl), '')" 2>/dev/null || true)" ;;
    mariadb|mysql)
      got="$(QDB='' q "$side" "SHOW SESSION STATUS WHERE Variable_name IN ('Ssl_version', 'Ssl_cipher')" 2>/dev/null \
             | awk -F'|' '$2 != "" { v[$1] = $2 } END { if (v["Ssl_version"] != "") print v["Ssl_version"] " " v["Ssl_cipher"] }' || true)" ;;
    mongodb)
      # The driver refuses to connect without TLS when tls=true, so a working
      # connection in require/verify mode is itself the evidence.
      [ "$mode" = disable ] || got="TLS (enforced by the client: tls=true$( [ "$mode" = verify ] && echo ', certificate verified' ))" ;;
  esac
  A[${P}_TLS]="${got:-none}"
  if [ -n "$got" ]; then
    ok "$side connection encrypted: $got$( [ "$mode" = verify ] && echo ' — server certificate verified' )"
  elif [ "$mode" = disable ]; then
    WARNINGS+=("$side connection is NOT encrypted (${P}_SSL=disable, ALLOW_INSECURE_TRANSPORT=yes): data and credentials cross the network in plain text.")
  else
    BLOCKERS+=("$side connection is not encrypted although ${P}_SSL=$mode — check the server's TLS configuration.")
  fi
}

cmd_assess() {
  rm -f "$STATE/top_tables.txt" "$STATE/no_pk.txt" "$STATE/lob_columns.txt" "$STATE/lob_max.txt"
  log "Assessing '$MIGRATION_NAME': $SRC_ENGINE $SRC_HOST/$SRC_DB → $TGT_ENGINE $TGT_HOST/$TGT_DB  (client: $CLIENT_MODE)"
  case "$SRC_ENGINE" in
    postgres) assess_postgres ;;
    mariadb|mysql) assess_mysqlish ;;
    mongodb) assess_mongodb ;;
  esac
  touch "$STATE/top_tables.txt" "$STATE/no_pk.txt" "$STATE/lob_columns.txt"
  if is_xengine; then
    x_preview
  else
    rm -f "$STATE/conversion.md"
  fi
  assess_transport src
  [ -z "${A[TGT_VERSION]:-}" ] || assess_transport tgt

  # Character encoding (requirement: garbled text with non-Unicode sources)
  case "${A[SRC_ENCODING]:-}" in
    UTF8|utf8*|UTF-8*) ;;
    *) WARNINGS+=("Source encoding ${A[SRC_ENCODING]:-unknown} is not Unicode. Include a check of non-ASCII sample rows in the test migration.") ;;
  esac
  if [ -n "${A[TGT_ENCODING]:-}" ] && [ "${A[TGT_ENCODING]}" != "${A[SRC_ENCODING]}" ] && [ "$SRC_ENGINE" = postgres ]; then
    WARNINGS+=("Encoding differs: source ${A[SRC_ENCODING]}, target ${A[TGT_ENCODING]}. Characters with no equivalent will fail to load.")
  fi
  if [ "${A[TGT_OBJECTS]:-0}" -gt 0 ]; then
    WARNINGS+=("The target already has ${A[TGT_OBJECTS]} object(s) in the migrated schema/database. full-load refuses a non-empty target — use an empty one.")
  fi
  NOTES+=("Users, roles and grants are never migrated by this tool; create them on the target (source grantees/owners: ${A[ROLES]:-n/a}).")

  A[CDC_READY]=yes; [ "${#CDC_ISSUES[@]}" -eq 0 ] || A[CDC_READY]=no
  A[ASSESSED_AT]="$(date -u +%FT%TZ)"

  { local k; for k in "${!A[@]}"; do printf '%s=%q\n' "$k" "${A[$k]}"; done; } > "$STATE/assessment.env"
  printf '%s\n' "${BLOCKERS[@]+"${BLOCKERS[@]}"}"   > "$STATE/blockers.txt"
  printf '%s\n' "${WARNINGS[@]+"${WARNINGS[@]}"}"   > "$STATE/warnings.txt"
  printf '%s\n' "${NOTES[@]+"${NOTES[@]}"}"         > "$STATE/notes.txt"
  printf '%s\n' "${CDC_ISSUES[@]+"${CDC_ISSUES[@]}"}" > "$STATE/cdc_issues.txt"
  write_assessment_md
  echo
  ok "assessment written: $STATE/assessment.md"
  [ "${#BLOCKERS[@]}" -eq 0 ] || { warn "${#BLOCKERS[@]} blocker(s):"; printf '     - %s\n' "${BLOCKERS[@]}" >&2; }
  [ "${#WARNINGS[@]}" -eq 0 ] || { warn "${#WARNINGS[@]} warning(s):"; printf '     - %s\n' "${WARNINGS[@]}" >&2; }
  info "next: $PROG plan $CONF"
}

bullets() { # bullets <file> — markdown list, or "none"
  if [ -s "$1" ] && grep -q . "$1"; then sed '/^$/d; s/^/- /' "$1"; else echo "- none"; fi
}

write_assessment_md() {
  local f="$STATE/assessment.md"
  {
    echo "# Migration assessment — $MIGRATION_NAME"
    echo
    echo "Assessed ${A[ASSESSED_AT]} with \`$PROG assess\`. Raw values: \`assessment.env\`."
    echo
    echo "## 1. Purpose"
    echo
    if [ "$PURPOSE" = replication ]; then
      echo "**Medium/long-term continuous replication** — the target is kept in sync alongside the source."
    else
      echo "**Database migration** — move from the source environment to the target, then switch applications over."
    fi
    echo
    echo "## 2. Targets"
    echo
    echo "| | Source | Target |"
    echo "|---|---|---|"
    echo "| Engine | $SRC_ENGINE | $TGT_ENGINE |"
    echo "| Endpoint | \`$SRC_HOST:$SRC_PORT/$SRC_DB\` | \`$TGT_HOST:$TGT_PORT/$TGT_DB\` |"
    echo "| Version | ${A[SRC_VERSION]:-?} | ${A[TGT_VERSION]:-not reachable} |"
    echo "| Encoding / collation | ${A[SRC_ENCODING]:-?} ${A[SRC_COLLATION]:+/ ${A[SRC_COLLATION]}} | ${A[TGT_ENCODING]:-?} ${A[TGT_COLLATION]:+/ ${A[TGT_COLLATION]}} |"
    echo "| Encryption in transit (${SRC_SSL} / ${TGT_SSL}) | ${A[SRC_TLS]:-?} | ${A[TGT_TLS]:-?} |"
    echo
    echo "Migration type: **$(homogeneous && echo "homogeneous (same engine) — native tools" || { same_family && echo "same family ($SRC_ENGINE → $TGT_ENGINE) — native tools, full load only" || echo "heterogeneous — schema converted by this tool, full load only (see conversion.md)"; })**."
    echo
    echo "| Objects | Count | Migrated by |"
    echo "|---|---|---|"
    echo "| Tables / collections | ${A[TABLES]:-?} | dump + restore (and CDC) |"
    echo "| Views | ${A[VIEWS]:-0} | dump + restore |"
    [ -z "${A[MATVIEWS]:-}" ] || echo "| Materialized views | ${A[MATVIEWS]} | dump + restore (refreshed on load) |"
    [ -z "${A[FUNCTIONS]:-}" ] || echo "| Functions / procedures | ${A[FUNCTIONS]} | dump + restore |"
    [ -z "${A[SEQUENCES]:-}" ] || echo "| Sequences | ${A[SEQUENCES]} | dump; values re-synced at cutover |"
    [ -z "${A[TRIGGERS]:-}" ] || echo "| Triggers | ${A[TRIGGERS]} | dump + restore |"
    [ -z "${A[EVENTS]:-}" ] || echo "| Events | ${A[EVENTS]} | dump + restore |"
    [ -z "${A[INDEXES]:-}" ] || echo "| Indexes | ${A[INDEXES]} | dump + restore |"
    [ -z "${A[EXTENSIONS]:-}" ] || echo "| Extensions | ${A[EXTENSIONS]} | created on load (must be available on the target) |"
    echo "| Users / roles / grants | — | **manual** (${A[ROLES]:-n/a}) |"
    echo
    echo "### CDC readiness: **${A[CDC_READY]}**"
    echo
    bullets "$STATE/cdc_issues.txt"
    echo
    echo "## 3. Scale"
    echo
    echo "| Metric | Value |"
    echo "|---|---|"
    echo "| Data to migrate (incl. indexes) | $(hb "${A[SIZE_BYTES]:-0}") |"
    echo "| Whole database on disk | $(hb "${A[DB_BYTES]:-0}") |"
    echo "| Tables / collections | ${A[TABLES]:-?} |"
    echo "| Rows / documents (estimate) | ${A[ROWS]:-?} |"
    echo "| LOB columns | ${A[LOB_COLUMNS]:-0}${A[LOB_MAX_BYTES]:+ (longest value $(hb "${A[LOB_MAX_BYTES]}"))} |"
    echo "| Tables without a primary key | ${A[NO_PK]:-0} |"
    if [ -n "${A[LOG_BYTES_PER_HOUR]:-}" ]; then
      echo "| Transaction log generation | $(hb "${A[LOG_BYTES_PER_HOUR]}")/hour (${A[OPLOG_WINDOW_HOURS]:+oplog average}${A[OPLOG_WINDOW_HOURS]:-sampled for ${SAMPLE_SECONDS}s} — measure again at peak) |"
    else
      echo "| Transaction log generation | not measured |"
    fi
    echo
    echo "Largest tables:"
    echo
    echo "| Table | Size | Rows |"
    echo "|---|---|---|"
    local n s r
    while IFS='|' read -r n s r; do [ -n "$n" ] && echo "| \`$n\` | $(hb "$s") | $r |"; done < "$STATE/top_tables.txt"
    echo
    [ "${A[LOB_COLUMNS]:-0}" -eq 0 ] || { echo "LOB columns: see \`lob_columns.txt\`${A[LOB_MAX_BYTES]:+ and \`lob_max.txt\`}."; echo; }
    [ "${A[NO_PK]:-0}" -eq 0 ] || { echo "Tables without a primary key: see \`no_pk.txt\`."; echo; }
    [ -z "$EXCLUDE_DATA_TABLES" ] || { echo "Data **not** migrated (EXCLUDE_DATA_TABLES): \`$EXCLUDE_DATA_TABLES\`"; echo; }
    echo "## 4–6. Downtime, latency, deadline"
    echo
    echo "| Requirement | Value |"
    echo "|---|---|"
